            "default": 20,
            "description": "Max strikes per page",
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "strike_offset": {
            "default": 0,
            "description": "Strike pagination offset",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "symbol"
        ],
        "additionalProperties": false
      }
    },
