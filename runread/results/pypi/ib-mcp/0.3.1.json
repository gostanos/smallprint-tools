            "type": "string"
          },
          "currency": {
            "default": "USD",
            "description": "Currency (e.g., USD)",
            "type": "string"
          },
          "trading_class": {
            "default": "",
            "description": "Filter to a single option trading class (optional)",
            "type": "string"
          },
          "min_strike": {
            "default": 0,
            "description": "Lowest strike (0 = no bound)",
            "type": "number"
          },
          "max_strike": {
            "default": 0,
            "description": "Highest strike (0 = no bound)",
            "type": "number"
          },
