            ],
            "type": "string",
            "default": "managed",
            "description": "Use a server-managed checkout or an existing clean local checkout."
          },
          "local_source_path": {
            "anyOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Local repository root for source_mode=local. Relative paths resolve from the server working directory, must remain beneath it, and default to '.'. The caller must keep this live checkout stable until the review is ready. Invalid for managed mode."
