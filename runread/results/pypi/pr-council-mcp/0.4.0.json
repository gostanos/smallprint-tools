            "default": null,
            "description": "Optional finalized context items supplied by the calling agent."
          },
          "mode": {
            "enum": [
              "auto",
              "initial",
              "follow_up"
            ],
            "type": "string",
            "default": "auto",
            "description": "Auto-detect an earlier published review, force initial review, or require follow-up."
          },
          "baseline_operation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
