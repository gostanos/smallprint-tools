  "tools": [
    {
      "name": "confluence_search",
      "description": "Find Confluence pages with CQL, so a page can be located by name.\n\n``cql`` is a Confluence Query Language string. Useful shapes::\n\n    title ~ \"deployment runbook\"\n    space = DOCS and title ~ \"runbook\"\n    space = DOCS and text ~ \"rollback\" and type = page\n    label = \"postmortem\" and lastmodified > now(\"-30d\")\n\nReturns compact rows; feed an ``id`` straight into ``confluence_get_page``.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cql": {
            "type": "string"
          },
          "limit": {
            "default": 25,
            "type": "integer"
          }
        },
        "required": [
          "cql"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "confluence_get_page",
      "description": "Fetch a Confluence page by URL or numeric page ID.\n\n``body_format`` is ``storage`` (the raw XHTML you must pass back to\n``confluence_update_page``) or ``text`` (macros and markup stripped).\nRead as ``text`` when the goal is to understand the page: storage bodies are\nfull of ``<ac:structured-macro>`` that a model will happily mangle on the\nway back out. Read as ``storage`` only when about to write.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page_url_or_id": {
            "type": "string"
          },
          "body_format": {
            "default": "storage",
            "type": "string"
          }
        },
        "required": [
          "page_url_or_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
