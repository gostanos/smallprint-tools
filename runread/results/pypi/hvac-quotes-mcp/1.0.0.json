        ]
      }
    },
    {
      "name": "get_quotes",
      "description": "Get all quotes received for an RFQ. Returns pricing, availability, and lead time from distributors.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "rfq_id": {
            "type": "string",
            "description": "The RFQ ID"
          }
        },
        "required": [
          "rfq_id"
        ]
      }
    },
    {
