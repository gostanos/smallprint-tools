  "installScriptsRan": false,
  "envNames": [],
  "args": [],
  "run": {
    "host": "es-backend",
    "container": "podman",
    "image": "docker.io/library/python:3.12-slim-bookworm",
    "node": "v22.23.2",
    "sdk": "1.32.1",
    "at": "2026-10-12T21:34:26.800Z"
  },
  "status": "tools",
  "tools": [
    {
      "name": "pasm_context",
      "description": "取 PASM 认知上下文（只读，不写记忆）。返回：与当前话题相关的长期记忆、当前情绪值、人格、可用动作池。**这是把 PASM 接进大模型提示词的首选工具** —— 先调它，再把 recalled 里的内容当作'你确实记得的事'写进回复。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "当前用户说的话/话题，用于检索相关记忆"
          },
          "k": {
            "type": "integer",
            "description": "最多返回几条记忆，默认 5",
            "default": 5
          },
          "agent_id": {
            "type": "string",
            "description": "智能体 id，默认 default。不同 id 记忆互相隔离",
            "default": "default"
          }
        },
        "required": []
      }
    },
    {
      "name": "pasm_recall",
      "description": "在 PASM 长期记忆里检索与 query 相关的经历，返回标题/摘要/标签/重要度。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "检索词"
          },
          "k": {
            "type": "integer",
            "description": "返回条数，默认 5",
            "default": 5
          },
          "agent_id": {
            "type": "string",
            "default": "default"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "pasm_semantic",
      "description": "语义检索（认知层）：换一种说法也能命中，并解释每条为什么被召回。适合当 pasm_recall 检索不到时的第二步 —— 它走向量 + 中文同义扩展，并按'记忆保留度'加权（很久没被唤起的记忆会自然降权）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "检索词（可以是完整的问句）"
          },
          "k": {
            "type": "integer",
            "description": "返回条数，默认 5",
            "default": 5
          },
          "use_focus": {
            "type": "boolean",
            "description": "是否按当前焦点加权，默认 true",
            "default": true
          },
          "use_forgetting": {
            "type": "boolean",
            "description": "是否启用遗忘曲线，默认 true",
            "default": true
          },
          "agent_id": {
            "type": "string",
            "default": "default"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "pasm_focus",
      "description": "焦点栈：查看或更新'现在在聊什么'。长对话里先压入当前话题，后续检索会自动给相关内容加权，避免跑题。不传 topic 就是查看。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "description": "当前话题（不传则只看不写）"
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "涉及的实体/关键词"
          },
          "weight": {
            "type": "number",
            "description": "权重，默认 1.0",
            "default": 1
          },
          "n": {
            "type": "integer",
            "description": "渲染几条焦点，默认 3",
            "default": 3
          },
          "agent_id": {
            "type": "string",
            "default": "default"
          }
        },
        "required": []
      }
    },
    {
      "name": "pasm_consolidate",
      "description": "记忆巩固（睡眠回放）：把高度相似的重复经历蒸馏成一条要点，并把源条目标记为已合并，避免记忆池被重复项撑爆。默认只给建议（apply=false），确认后传 apply=true 执行。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "apply": {
            "type": "boolean",
            "description": "是否真的执行（默认 false，只出建议）",
            "default": false
          },
          "agent_id": {
            "type": "string",
            "default": "default"
          }
        },
        "required": []
      }
    },
    {
      "name": "pasm_observe",
      "description": "把一件事写进 PASM 长期记忆。值得记住的用户信息、承诺、偏好、共同经历都应该写进来。salience 越高越不容易被淘汰（1-5，重要的事用 4-5）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "记忆标题，简短醒目"
          },
          "brief": {
            "type": "string",
            "description": "详细描述"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "标签，便于检索命中"
          },
          "salience": {
            "type": "integer",
            "description": "重要度 1-5，默认 2",
            "default": 2,
            "minimum": 1,
            "maximum": 5
          },
          "category": {
            "type": "string",
            "description": "分类，默认 日常",
            "default": "日常"
          },
          "agent_id": {
            "type": "string",
            "default": "default"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    {
      "name": "pasm_feel",
      "description": "向 PASM 报告一个带情绪效价的事件，驱动情绪状态演化（valence: -1 负面 ~ +1 正面）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "description": "事件描述"
          },
          "valence": {
            "type": "number",
            "description": "情绪效价 -1.0 ~ 1.0",
            "minimum": -1,
            "maximum": 1
          },
          "agent_id": {
            "type": "string",
            "default": "default"
          }
        },
        "required": [
          "event",
          "valence"
        ]
      }
    },
    {
      "name": "pasm_act",
      "description": "让 PASM 按「人格基线 + 反馈学到的偏好」从动作池里选一个动作。不传 candidates 就用智能体自己的动作池。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "candidates": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "候选动作列表（可选）"
          },
          "agent_id": {
            "type": "string",
            "default": "default"
          }
        },
        "required": []
      }
    },
    {
      "name": "pasm_feedback",
      "description": "用户对 PASM 行为的反馈，会塑形后续动作选择。kind: praise(夸奖)/scold(责怪)/poke(调侃)/hug(安慰)/ignore(无视)。**必须尽量带 action**（被评价的那个动作名），否则偏好会集中在某一个动作上。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "praise",
              "scold",
              "poke",
              "hug",
              "ignore"
            ]
          },
          "action": {
            "type": "string",
            "description": "被反馈的动作名，强烈建议传"
          },
          "agent_id": {
            "type": "string",
            "default": "default"
          }
        },
        "required": [
          "kind"
        ]
      }
    },
    {
      "name": "pasm_chat",
      "description": "走一次完整认知回路：检索记忆 → 渲染回复 → 把这次对话写进记忆。**回复是模板渲染、非 LLM 生成**，用于快速验证或纯离线场景；要自然语言效果请用 pasm_context 配合你自己的模型。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "用户输入"
          },
          "agent_id": {
            "type": "string",
            "default": "default"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "pasm_persona",
      "description": "查看或更新人格。不传 persona 就是查看。传入为**合并更新**（未提及的键保持原值）。常用键：name/role/tone/temper(0-1 主动性)/energy(0-1 活跃度)/play(0-1 俏皮度)/actions(动作池数组)。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "persona": {
            "type": "object",
            "description": "要合并进去的人格字段（可选）"
          },
          "agent_id": {
            "type": "string",
            "default": "default"
          }
        },
        "required": []
      }
    },
    {
      "name": "pasm_status",
      "description": "查看 PASM 状态快照：档位(light/core/bionic)、记忆条数、情绪值、交互次数、落盘目录。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string",
            "default": "default"
          }
        },
        "required": []
      }
    },
    {
      "name": "pasm_save",
      "description": "把 PASM 状态立即落盘（不传 agent_id 则保存全部已加载的智能体）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string",
            "description": "可选；不传则保存全部"
          }
        },
        "required": []
      }
    }
  ],
  "serverInfo": {
    "name": "pasm-mcp-server",
    "version": "0.2.1"
  },
  "protocolVersion": null,
  "instructions": "PASM 认知内核：提供长期记忆、情绪状态与动作倾向。典型用法是先 pasm_context 取认知上下文，再据此回复；有值得记住的事就 pasm_observe 写进去；被夸/被凶就用 pasm_feedback 塑形。",
  "durationMs": 2260,
  "stderr": "[pasm-mcp] starting (persist=/tmp/.pasm-mcp)\n"
