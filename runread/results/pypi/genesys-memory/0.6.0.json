    {
      "name": "memory_store",
      "description": "Store a new memory in the causal memory graph. Use `related` for writer-specified typed edges (each {id, type}); `related_to` is legacy and always creates caused_by edges. May return `possible_conflicts` — heuristic hints, not verified contradictions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "source_session": {
            "type": "string",
            "default": ""
          },
          "related_to": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Legacy: ids of nodes to link via caused_by. Prefer `related`."
          },
          "related": {
            "type": "array",
            "description": "Typed explicit edges. Direction: new_node --type--> target.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "type"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "caused_by",
                    "supports",
                    "contradicts",
                    "supersedes",
                    "derived_from",
                    "related_to",
                    "temporal_sequence"
                  ]
                }
              }
            }
          },
          "category": {
            "type": "string",
            "description": "Free-form classification (suggested: professional, educational, family, location)."
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private",
              "org"
            ],
            "default": "private"
          },
          "org_id": {
            "type": "string",
            "description": "Required when visibility is 'org'. Must be an org the caller belongs to."
          }
        },
        "required": [
          "content"
        ]
      }
    },
    {
