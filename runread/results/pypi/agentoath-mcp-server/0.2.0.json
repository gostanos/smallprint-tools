  "status": "tools",
  "tools": [
    {
      "name": "agentoath_create_identity",
      "description": "Create a new AI agent identity with an Ed25519 keypair and DID. The identity is saved to disk and can be reused across sessions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Human-readable name for the agent."
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of capability strings (e.g. ['chat', 'code_review'])."
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "agentoath_sign_receipt",
      "description": "Sign a trust receipt recording an interaction with another agent. Requires an active agent identity (create one first).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "to_agent_did": {
            "type": "string",
            "description": "DID of the receiving agent (did:trust:agent:...)."
          },
          "action": {
            "type": "string",
            "description": "Type of interaction (e.g. collaboration, agreement, delegation)."
          },
          "rating": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10,
            "description": "Quality rating from 0 (worst) to 10 (best)."
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of the interaction."
          }
        },
        "required": [
          "to_agent_did",
          "action",
          "rating"
        ]
      }
    },
    {
      "name": "agentoath_verify_receipt",
      "description": "Verify the cryptographic signature of a trust receipt. Returns whether the receipt was genuinely signed by the claimed agent.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "receipt_json": {
            "type": "object",
            "description": "The trust receipt as a JSON object."
          },
          "from_public_key": {
            "type": "string",
            "description": "Public key of the signing agent (ed25519:base64...)."
          }
        },
        "required": [
          "receipt_json",
          "from_public_key"
        ]
      }
    },
    {
      "name": "agentoath_check_trust",
      "description": "Check an agent's trust score computed from all stored receipts. The score is a value between 0.0 and 1.0.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_did": {
            "type": "string",
            "description": "DID of the agent to check (did:trust:agent:...)."
          }
        },
        "required": [
          "agent_did"
        ]
      }
    },
    {
      "name": "agentoath_lookup_agent",
      "description": "Look up an agent's public identity by DID. Returns name, capabilities, public key, and trust score.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "did": {
            "type": "string",
            "description": "The agent's DID (did:trust:agent:...)."
          }
        },
        "required": [
          "did"
        ]
      }
    },
    {
      "name": "agentoath_list_receipts",
      "description": "List trust receipts for a given agent. Can filter by direction (from, to, or both).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_did": {
            "type": "string",
            "description": "DID of the agent (did:trust:agent:...)."
          },
          "direction": {
            "type": "string",
            "enum": [
              "from",
              "to",
              "both"
            ],
            "description": "Filter receipts by direction (default: both)."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Maximum number of receipts to return (default: 20)."
          }
        },
        "required": [
          "agent_did"
        ]
      }
    }
