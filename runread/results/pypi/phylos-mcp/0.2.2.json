                "description": "Tope global de llamadas concurrentes para este plan. Sirve para convivir con otros planes en el mismo proceso sin saturar las fuentes.",
                "title": "Max Parallel Calls"
              }
            },
            "title": "Budget",
            "type": "object"
          },
          "DevmcpEnvelope": {
            "additionalProperties": false,
            "properties": {
              "outcome": {
                "items": {
                  "description": "ref:x (semilla) | artifact:x.y (dato) | effect:x.y (cambio observable)",
                  "pattern": "^(ref|artifact|effect):[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
                  "type": "string"
                },
                "title": "Outcome",
                "type": "array"
