              },
              "explain": {
                "default": true,
                "title": "Explain",
                "type": "boolean"
              },
              "seeds": {
                "additionalProperties": true,
                "description": "Artefactos ya conocidos que el planner da por resueltos sin gastar un read_*. Clave = artifact_id. Se validan contra su esquema igual que si vinieran de una fuente: una semilla mal formada es un error de entrada, no un atajo.",
                "title": "Seeds",
                "type": "object"
              },
              "relaxation_reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Por qué se pide bajar el listón de evidencia. Viaja hasta el `PolicyRelaxation` que queda en el ledger. Sin este campo, `relaxations.require_reason` de devmcp.policy.yml era insatisfacible desde fuera: toda relajación se registraba como 'sin justificación declarada' y la exigencia no podía cumplirse ni incumplirse, que es la peor forma de tener una regla.",
                "title": "Relaxation Reason"
              },
              "prefer": {
                "default": "evidence",
                "description": "Reordena los pesos de la función de coste. `evidence` (defecto) hace dominar γ; `latency` sube α; `cost` sube β. No cambia qué rutas existen, solo cuál gana.",
                "enum": [
                  "evidence",
                  "latency",
                  "cost"
                ],
                "title": "Prefer",
                "type": "string"
              }
            },
            "title": "DevmcpEnvelope",
            "type": "object"
          },
