    {
      "name": "do_execute_plan",
      "description": "Ejecuta un plan emitido por can_do. Es la única que aplica efectos. Con dry_run anuncia lo que aplicaría sin aplicarlo.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "plan_id": {
            "pattern": "^plan_[A-Za-z0-9_]+$",
            "title": "Plan Id",
            "type": "string"
          },
          "dry_run": {
            "default": false,
            "description": "Anuncia qué se aplicaría y no aplica nada. Es lo que permite enseñar los efectos antes de consentirlos, en vez de pedir consentimiento a ciegas.",
            "title": "Dry Run",
            "type": "boolean"
          },
          "background": {
            "default": false,
            "description": "Devuelve en cuanto el plan está en marcha, con estado EXECUTING, y deja que el cliente reconsulte con read_plan_status. Un plan de 17 steps tarda segundos o minutos, y una llamada MCP que no contesta en ese tiempo es indistinguible de un servidor colgado.",
            "title": "Background",
            "type": "boolean"
          },
          "seeds": {
            "additionalProperties": true,
            "description": "Artefactos que quien llama ya tiene resueltos y no hay que leer.",
            "title": "Seeds",
            "type": "object"
          }
        },
        "required": [
          "plan_id"
        ],
        "additionalProperties": false,
        "description": "Entrada de `do_execute_plan`.",
        "title": "ExecutePlanInput"
      }
    },
    {
      "name": "read_plan_status",
      "description": "En qué estado quedó un plan, qué aprobaciones faltan y qué dice su traza. Es como se sale de AWAITING_*.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "plan_id": {
            "pattern": "^plan_[A-Za-z0-9_]+$",
            "title": "Plan Id",
            "type": "string"
          }
        },
        "required": [
          "plan_id"
        ],
        "additionalProperties": false,
        "description": "Entrada de `read_plan_status`.",
        "title": "PlanStatusInput"
      }
    },
    {
      "name": "do_approve_step",
      "description": "Una persona autoriza un step con gate. Queda en el ledger con nombre.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "plan_id": {
            "pattern": "^plan_[A-Za-z0-9_]+$",
            "title": "Plan Id",
            "type": "string"
          },
          "step_id": {
            "pattern": "^s[0-9]+$",
            "title": "Step Id",
            "type": "string"
          },
