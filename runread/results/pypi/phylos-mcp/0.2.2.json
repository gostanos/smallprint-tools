            "minLength": 1,
            "title": "Approver",
            "type": "string"
          }
        },
        "required": [
          "plan_id",
          "step_id",
          "approver"
        ],
        "additionalProperties": false,
        "description": "Entrada de `do_approve_step`.\n\n`approver` es obligatorio y sin valor por omisión. Una aprobación anónima no se\ndistingue de un `approvals` que el propio proceso se inyectó, y toda la escalera de\n`Gate` se apoya en que `confirm` signifique que alguien concreto dijo que sí.",
        "title": "ApproveStepInput"
      }
    },
    {
      "name": "read_capabilities",
      "description": "Qué sabe hacer este servidor y con qué fuentes. Publica el tamaño del catálogo, no el catálogo: quien llama declara intención.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "description": "`read_capabilities` y `read_contract` no reciben nada.\n\nExiste como modelo en vez de como `{}` escrito a mano para que los seis tools publiquen\nsu esquema por el mismo camino. Un tool cuyo esquema se escribe aparte es el que se\nqueda sin actualizar.",
        "title": "NoInput"
      }
    },
    {
      "name": "read_contract",
      "description": "El handshake del ADR-003 §2: versión de contrato, capacidades y hash del perfil de concurrencia.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "description": "`read_capabilities` y `read_contract` no reciben nada.\n\nExiste como modelo en vez de como `{}` escrito a mano para que los seis tools publiquen\nsu esquema por el mismo camino. Un tool cuyo esquema se escribe aparte es el que se\nqueda sin actualizar.",
        "title": "NoInput"
      }
    },
    {
      "name": "do_open_monitor",
      "description": "Abre el panel de solo lectura sobre este ledger y devuelve su URL: qué planes hay en marcha y, sobre todo, a quién estamos esperando que firme. Idempotente. El panel NO aprueba nada. action=stop lo para; action=status pregunta sin tocar.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "default": "start",
            "enum": [
              "start",
              "stop",
              "status"
            ],
            "title": "Action",
            "type": "string"
          },
          "port": {
            "default": 8787,
            "maximum": 65535,
            "minimum": 1024,
            "title": "Port",
            "type": "integer"
          },
          "build": {
            "default": false,
            "title": "Build",
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "description": "Entrada de `do_open_monitor`.\n\n`action` en vez de tres tools separados: abrir, parar y preguntar son la misma decision\nsobre la misma cosa, y partirla en tres gastaria tres de los ocho huecos que §13.1 deja.\n\n`build` va apagado por defecto y es deliberado: compilar el panel necesita node y tarda\nminutos. Encenderlo tiene que ser una eleccion de quien llama, no una sorpresa dentro de\nuna llamada que parecia instantanea.",
        "title": "OpenMonitorInput"
      }
