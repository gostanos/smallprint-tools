  "tools": [
    {
      "name": "bee_chat",
      "description": "Use for general or specialist questions that do not require a more specific Bee tool. Returns generated text from the selected domain and model tier. The gateway enforces the API key's plan, tenant policy, token allowance, and usage metering.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "The question or request"
          },
          "domain": {
            "type": "string",
            "description": "Optional domain specialist (defaults to general).",
            "enum": [
              "general",
              "programming",
              "ai",
              "cybersecurity",
              "cryptography_pqc",
              "quantum",
              "fintech",
              "blockchain",
              "infrastructure",
              "research",
              "business"
            ]
          },
          "model": {
            "type": "string",
            "description": "Optional Bee model tier. Limited to your plan. Default: bee-cell.",
            "enum": [
              "bee-cell",
              "bee-brood",
              "bee-comb",
              "bee-buzz",
              "bee-hive",
              "bee-swarm"
            ]
          },
          "max_tokens": {
            "type": "integer",
            "description": "Max response tokens",
            "default": 512
          },
          "temperature": {
            "type": "number",
            "description": "Sampling temperature (optional)"
          }
        },
        "required": [
          "message"
        ]
      },
      "annotations": {
        "title": "Ask Bee",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
