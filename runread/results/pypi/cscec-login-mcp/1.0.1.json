  "status": "tools",
  "tools": [
    {
      "name": "cscec_qr_create",
      "description": "Create a CSCEC WeCom QR login session. The MCP server automatically (a) opens the login page in the user's default browser, (b) writes the URL to ~/Desktop/cscec-login-url.txt, and (c) shows a desktop notification. The user sees the QR even if the chat client fails to render images. After calling, just tell the user where to look (browser tab + desktop file) and then call cscec_qr_wait with the returned session_id. Do NOT call cscec_qr_create again while the login page is open — the page refreshes its own QR.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "qr_host": {
            "type": "string"
          },
          "appid": {
            "type": "string"
          },
          "agentid": {
            "type": "string"
          },
          "redirect_uri": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "portal_base": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "cscec_qr_wait",
      "description": "Wait for the user to scan the QR in the login page. Blocks until scanned or timeout (default 100s). Accepts the literal 'latest' as session_id. On timeout the QR has expired — call cscec_qr_create again.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Opaque MCP login-session identifier."
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 900
          }
        },
        "required": [
          "session_id"
        ]
      }
    },
    {
      "name": "cscec_portal_exchange",
      "description": "Exchange the one-time QR auth code for a private portal token.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Opaque MCP login-session identifier."
          }
        },
        "required": [
          "session_id"
        ]
      }
    },
    {
      "name": "cscec_portal_list_apps",
      "description": "Resolve the portal config tree and list the logged-in user's personal applications.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Opaque MCP login-session identifier."
          },
          "config_id": {
            "type": "string",
            "description": "Optional approved config UUID; otherwise resolve it from /app/config/tree."
          },
          "config_name": {
            "type": "string",
            "description": "Config-tree name, default 岗位场景."
          },
          "is_role": {
            "type": "string",
            "enum": [
              "true",
              "false"
            ],
            "description": "Default true for the user's role-scoped applications."
          }
        },
        "required": [
          "session_id"
        ]
      }
    },
    {
      "name": "cscec_portal_search_apps",
      "description": "Search the portal application catalog by keyword after portal authentication.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Opaque MCP login-session identifier."
          },
          "keyword": {
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "keyword"
        ]
      }
    },
    {
      "name": "cscec_select_app",
      "description": "Persist the application selected by index from the latest portal application list.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Opaque MCP login-session identifier."
          },
          "index": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "session_id",
          "index"
        ]
      }
    },
    {
      "name": "cscec_exchange_market_code",
      "description": "Exchange an approved application-market redirect code and privately record the xindun token.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Opaque MCP login-session identifier."
          },
          "code": {
            "type": "string",
            "description": "One-time application-market redirect code; never reuse it."
          },
          "endpoint": {
            "type": "string"
          },
          "client_id": {
            "type": "string"
          },
          "user_type": {
            "type": "string",
            "default": "admin"
          }
        },
        "required": [
          "session_id",
          "code"
        ]
      }
    },
    {
      "name": "cscec_token_status",
      "description": "Inspect non-secret presence and metadata for a portal or xindun token.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Opaque MCP login-session identifier."
          },
          "token_kind": {
            "type": "string",
            "enum": [
              "portal",
              "market"
            ],
            "default": "portal"
          }
        },
        "required": [
          "session_id"
        ]
      }
    },
    {
      "name": "cscec_session_cleanup",
      "description": "Delete this MCP login session's private QR, token, and application files.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Opaque MCP login-session identifier."
          }
        },
        "required": [
          "session_id"
        ]
      }
    }
  ],
