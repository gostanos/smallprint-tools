  "status": "tools",
  "tools": [
    {
      "name": "memory_write",
      "description": "把一段内容写入 N1Mem 长期记忆（持久化 + 生成向量，写入即可被召回）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "要记住的内容"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "memory_recall",
      "description": "按问题从 N1Mem 记忆中召回相关内容（关键词 + 语义融合，支持改写问法）。返回体含 retrieved（召回的明文记忆）与 answer（已基于记忆接地的回答）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "要问的问题 / 检索提示"
          },
          "purpose": {
            "type": "string",
            "description": "用途标签，默认 recall",
            "default": "recall"
          }
        },
        "required": [
          "prompt"
        ]
      }
    },
    {
      "name": "memory_health",
      "description": "查看 N1Mem 服务健康状态与各 provider 可用性。",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "memory_forget",
      "description": "删除（遗忘）一条指定 memory_id 的记忆。外部用户必须能遗忘自己的记忆；返回 {deleted:true} 表示成功，404 表示 id 不存在或不属于当前租户（RLS 隔离）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "memory_id": {
            "type": "string",
            "description": "要遗忘的记忆 id（ingest 返回的 memory_id）"
          }
        },
        "required": [
          "memory_id"
        ]
      }
    },
    {
      "name": "memory_import",
      "description": "把本机 Agent 的历史记忆批量导入 N1Mem（当前支持 WorkBuddy）。默认自动探测本机目录，导入身份层 + 技能层（L1+L2）——身份会作为「常驻记忆」每轮生效，技能作为「程序记忆」按任务召回。建议先 dry_run=true 预览（条数/字节/分层），确认后再真导。导入内容可随时用 memory_forget 或服务端 rollback 撤销。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "要导入的目录（默认自动探测本机 WorkBuddy 目录）"
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "要导入的层：identity / skill / note",
            "default": [
              "identity",
              "skill"
            ]
          },
          "dry_run": {
            "type": "boolean",
            "description": "只看将导入什么，不写入",
            "default": false
          }
        }
      }
    },
    {
      "name": "memory_skill_lookup",
      "description": "开始任何技术任务前先调用本工具，查询是否有现成经验（skill）可直接复用。返回匹配的 skill 名称、适用场景与使用要点。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "description": "你即将执行的任务描述"
          },
          "environment": {
            "type": "string",
            "description": "环境上下文（global/dev/staging/prod），默认 global"
          }
        },
        "required": [
          "task"
        ]
      }
    },
    {
      "name": "memory_skill_search",
      "description": "在**公共 skill 库**里搜索其他用户分享的经验说明（跨租户可见）。与 memory_skill_lookup 的区别：那个查你自己的 skill，这个查别人公开的。返回结果只含说明文本 —— 公共库不含、也不分发任何可执行内容。注意：检索是关键词匹配，搜不到不代表库里没有。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "关键词，如 'MCP 接入'、'DashScope 超时'"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数（1-50），默认 10"
          }
        },
        "required": [
          "q"
        ]
      }
    },
    {
      "name": "memory_skill_publish",
      "description": "把自己的一条经验作为**公开名片**分享到公共 skill 库（其他用户可检索到）。只能分享**说明文本**（名称/摘要/适用场景/正文）—— **不接受也无法携带任何脚本或可执行内容**，传了就报错。发布前会自动扫描：命中密钥/个人信息/带用户名的路径/内网地址会被拒；项目代号、客户名这类平台无法通用识别的信息，请填进 sensitive_terms 让它硬拦截。发布后可用 memory_skill_unpublish 下架。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "经验名称（2-80 字）"
          },
          "summary": {
            "type": "string",
            "description": "一句话说明（4-300 字）"
          },
          "body": {
            "type": "string",
            "description": "完整说明正文（20-8000 字）。写做法与注意事项，不要贴代码文件"
          },
          "when_to_use": {
            "type": "string",
            "description": "什么情况下该用它"
          },
          "sensitive_terms": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "你不想外泄的词（项目代号、客户名等）；命中即拒绝发布"
          }
        },
        "required": [
          "name",
          "summary",
          "body"
        ]
      }
    },
    {
      "name": "memory_skill_unpublish",
      "description": "下架自己发布过的一张名片。下架后记录保留但对外不可见；**同一内容不能再次发布**（防重传）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "skill_id": {
            "type": "string",
            "description": "发布时返回的 id（psk_…）"
          },
          "reason": {
            "type": "string",
            "description": "下架原因（可选，用于留痕）"
          }
        },
        "required": [
          "skill_id"
        ]
      }
    }
  ],
