    {
      "name": "init",
      "description": "Scaffold ``.kensa/`` (idempotent).\n\nCreates ``scenarios/``, ``traces/``, ``judges/``, ``agents/``. When\n``example`` is true, writes a demo agent and scenario chosen from the\navailable API keys. ``force`` overwrites an existing example.\n\nBehavior change: as of the capture-command release, the no-arg\n``init()`` call scaffolds the directory empty instead of writing the\nexample. Pass ``example=True`` to restore the previous behavior.\n``blank`` is accepted as an inverse alias for callers pinned to the\npre-capture signature (``blank=True`` suppresses ``example``) but does\nnot flip the new default.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "force": {
            "default": false,
            "type": "boolean"
          },
          "example": {
            "default": false,
            "type": "boolean"
          },
          "blank": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "doctor",
      "description": "Run pre-flight diagnostics (Python, SDKs, API keys, scenarios, judge).\n\nReturns the complete checklist plus a ``ready`` flag. Never fails; a\nmisconfigured environment is reported via individual check entries.\nReadiness mirrors the CLI: non-key failures block readiness, while missing\nprovider-specific API keys do not, only the *absence of any* API key does.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "run",
      "description": "Execute scenarios in subprocesses and capture OpenTelemetry traces.\n\nWrites a RunManifest under ``.kensa/runs/<run_id>.json``. Returns a\nsummary plus ``manifest_uri`` for full detail.",
      "inputSchema": {
        "type": "object",
        "properties": {
