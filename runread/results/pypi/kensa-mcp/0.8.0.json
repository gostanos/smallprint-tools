          "scenario_dir": {
            "default": ".kensa/scenarios",
            "type": "string"
          },
          "timeout": {
            "default": 300,
            "type": "integer"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "judge",
      "description": "Score a run with deterministic checks plus the LLM judge.\n\nDefaults to the latest run. Writes results to\n``.kensa/results/<run_id>.json``. Returns a summary plus ``results_uri``.",
