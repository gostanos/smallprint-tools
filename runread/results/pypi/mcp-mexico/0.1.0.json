    {
      "name": "get_interest_rate",
      "description": "Get a key Mexican interest rate from Banco de México, in percent per year.\n\n        Rates: `target` (Banxico policy rate), `tiie_28` (28-day TIIE), `tiie_funding`\n        (overnight TIIE de Fondeo) and `cetes_28` (28-day CETES, weekly auction).\n        Without `date`, returns the latest value. With `date`, returns the value for\n        that day or the most recent one before it. Check the `date` field of the result.\n        ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "rate": {
