    {
      "name": "get_uma",
      "description": "Get the official UMA (Unidad de Medida y Actualización) in Mexican pesos.\n\n    Returns the daily, monthly and annual values, the validity period and the\n    official source. Without `year`, returns the UMA in force today. Each year's\n    UMA takes effect on February 1, so in January the previous year's value applies.\n    ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Year"
          }
        },
        "title": "get_umaArguments"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_isr_table",
      "description": "Get the official ISR rate table for individuals (personas físicas) in Mexican pesos.\n\n    `monthly` is the Art. 96 table used for monthly withholdings and provisional\n    payments on wages; `annual` is the Art. 152 table used for the annual tax return.\n    Without `year`, returns the current year's table. To compute the tax, find the\n    bracket containing the taxable income, then: fixed_fee + (income - lower_limit)\n    * rate_percent / 100.\n    ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Year"
          },
          "period": {
            "default": "monthly",
            "enum": [
              "monthly",
              "annual"
            ],
            "title": "Period",
            "type": "string"
          }
        },
        "title": "get_isr_tableArguments"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_fix_rate",
      "description": "Get the FIX USD/MXN exchange rate published by Banco de México.\n\n        Without `date`, returns the latest FIX. With `date`, returns the FIX for that\n        day; on weekends and holidays there is no FIX, so it returns the most recent\n        one before that day. Check the `date` field of the result.\n        ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Date"
          }
        },
        "title": "get_fix_rateArguments"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_fix_rate_range",
      "description": "Get the daily FIX USD/MXN exchange rate between two dates (inclusive, max 366 days).\n\n        Only business days have a value.\n        ",
      "inputSchema": {
