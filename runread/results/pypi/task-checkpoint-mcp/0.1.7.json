  "status": "tools",
  "tools": [
    {
      "name": "tc_init",
      "description": "创建任务。已有活动任务会挂起而不是关闭。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "description": "工作区根目录"
          },
          "name": {
            "type": "string",
            "description": "任务名"
          },
          "goal": {
            "type": "string",
            "description": "任务目标"
          },
          "constraints": {
            "type": "string",
            "description": "约束"
          },
          "store": {
            "type": "string",
            "description": "存档目录；省略时用工作区内 .checkpoints"
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "额外的排除模式，按单个名字段匹配（目录名或路径第一段），如 [\"config\", \"*.local\"]"
          }
        },
        "required": [
          "root",
          "name"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tc_switch",
      "description": "切换活动任务。closed 任务会被拒绝。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "description": "工作区根目录"
          },
          "task_id": {
            "type": "string",
            "description": "要激活的任务 id"
          }
        },
        "required": [
          "root",
          "task_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tc_save",
      "description": "保存一个任务层步骤。close=true 时关闭任务且不再接受保存。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "description": "工作区根目录"
          },
          "title": {
            "type": "string",
            "description": "步骤标题"
          },
          "task_id": {
            "type": "string",
            "description": "任务 id。省略时使用当前活动任务"
          },
          "description": {
            "type": "string",
            "description": "为什么这么做"
          },
          "conclusion": {
            "type": "string",
            "description": "这一步的结论"
          },
          "verified": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "open_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next": {
            "type": "string",
            "description": "下一步"
          },
          "close": {
            "type": "boolean"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "预留路径范围参数；当前必须为空数组"
          }
        },
        "required": [
          "root",
          "title"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tc_capture",
      "description": "立即记录当前文件变化，不等静默期。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "description": "工作区根目录"
          }
        },
        "required": [
          "root"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tc_show",
      "description": "列出任务层步骤；include_drift=true 时同时列出变更层。index 可精确查看单步。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "description": "工作区根目录"
          },
          "task_id": {
            "type": "string",
            "description": "任务 id。省略时使用当前活动任务"
          },
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "include_drift": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "cursor": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "root"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tc_restore",
      "description": "按任务层序号或变更层编号恢复。index 与 drift_id 二选一；apply=false 只预览。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "description": "工作区根目录"
          },
          "index": {
            "type": "integer",
            "description": "任务层序号"
          },
          "drift_id": {
            "type": "string",
            "description": "变更层编号，例如 d0001"
          },
          "apply": {
            "type": "boolean",
            "description": "true 才写工作区"
          }
        },
        "required": [
          "root"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tc_resume",
      "description": "只读返回目标、当前步骤、未落档路径和下一步。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "description": "工作区根目录"
          },
          "task_id": {
            "type": "string",
            "description": "任务 id。省略时使用当前活动任务"
          }
        },
        "required": [
          "root"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tc_export",
      "description": "导出交接包到一个已存在的目录。敏感文件内容不会导出。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "description": "工作区根目录"
          },
          "to": {
            "type": "string",
            "description": "已存在的导出父目录"
          }
        },
        "required": [
          "root",
          "to"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tc_import",
      "description": "导入 tc_export 生成的交接包，在另一个目录或机器上接续任务。会校验任务 id 与工作区路径，拒绝重复任务、.. 穿越与符号链接目标；失败时撤销已写入的文件。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "description": "工作区根目录"
          },
          "package": {
            "type": "string",
            "description": "交接包目录，即 tc_export 返回的 path"
          }
        },
        "required": [
          "root",
          "package"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tc_compress",
      "description": "回收存档空间：删掉超过保留期的变更层内容。被回收的变更层不能再 restore，步骤基线不受影响。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "description": "工作区根目录"
          },
          "keep_seconds": {
            "type": "integer",
            "minimum": 0,
            "description": "保留最近多少秒内的变更层，默认 7 天"
          },
          "minimum": {
            "type": "integer",
            "minimum": 0,
            "description": "每条路径至少保留几份较旧的变更层，默认 20"
          },
          "maximum": {
            "type": "integer",
            "minimum": 1,
            "description": "每条路径最多保留几份变更层，默认 50"
          }
        },
        "required": [
          "root"
        ],
        "additionalProperties": false
      }
    }
  ],
