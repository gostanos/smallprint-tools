  "tools": [
    {
      "name": "list_recipes",
      "description": "List the user's whole recipe book (own + saved + queued + friend recipes), optionally filtered by title words, course, or ownership. Narrow with a filter when you can: the unfiltered book can run to well over a thousand rows. Each row has id, title, owned, and whichever of course_title, cuisine_title, main_ingredient_title, tag_titles, total_time (minutes) and rating are set — empty ones are left out. Rows carry no ingredients, directions, description, servings or nutrition — call get_recipe on an id for those. Inactive, removed and hidden recipes are left out.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "search": {
            "description": "Words to find in the title, case-insensitive; every word must appear, in any order. \"pork chive\" matches \"Juicy Pork & Chive Dumplings\".",
            "type": "string"
          },
          "course": {
            "description": "Course title, case-insensitive exact match, e.g. \"Breakfast\". list_courses has the names.",
            "type": "string"
          },
          "owned_only": {
            "description": "Only the user's own recipes, not saved or queued ones from friends.",
            "type": "boolean"
          },
          "full": {
            "description": "Return every listing field (photo_url, created_at/updated_at, course_id etc., saved/queued/planned_only, stats_total_events), empty ones included. Several times larger; filter first.",
            "type": "boolean"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
