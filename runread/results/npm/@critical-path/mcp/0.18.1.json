          },
          "levelResources": {
            "type": "boolean",
            "description": "With calendars 'assignee': delay tasks so each assignee works on one task at a time"
          },
          "levelingPriority": {
            "type": "string",
            "enum": [
              "slack",
              "priority",
              "dueDate",
              "order"
            ],
            "description": "Which ready task gets an assignee first when levelling (default: least slack, then task priority)"
          },
          "effort": {
            "type": "string",
            "enum": [
              "estimate",
              "remaining"
            ],
            "description": "'remaining' schedules only estimate minus logged hours for in-progress tasks (default: full estimates)"
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "title": "Calculate Critical Path",
        "readOnlyHint": true,
        "destructiveHint": false
