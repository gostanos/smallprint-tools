    {
      "name": "report_change",
      "description": "Beta. Report a code change to Helprism after judging its help-center impact (helprism-sync skill). Send only paths, the impact note and help-article prose: never code, diffs or file contents. Nothing publishes: update/create drafts go to the review inbox, verify goes to the freshness list. Returns the change id, suggestion ids and a reviewUrl to show the user. Works on Pro and Business.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "commit",
                  "pr"
                ],
                "description": "What the change is"
              },
              "id": {
                "type": "string",
                "description": "Commit sha or PR number"
              },
              "label": {
                "type": "string",
                "description": "Commit subject or PR title"
              },
              "url": {
                "type": "string",
                "description": "Link to the commit or PR"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false,
            "description": "The commit or PR this report is about"
          },
          "title": {
            "type": "string",
            "description": "Short title of the change (e.g. the commit subject)"
          },
          "filesTouched": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Repository paths the change touched. Paths only, no contents"
          },
          "impactNote": {
            "type": "string",
            "pattern": "^Help center impact: .+",
            "description": "\"Help center impact: NONE\" or \"Help center impact: <what changed for a user>\""
          },
          "changeClass": {
            "type": "string",
            "enum": [
              "new-behaviour",
              "changed-behaviour",
              "ui-copy-or-layout",
              "bugfix-restores-documented-behaviour",
              "internal",
              "marketing-site",
              "visual-only"
            ],
            "description": "The class from the skill. Stopping classes carry no suggestions"
          },
          "procedureVersion": {
            "type": "string",
            "default": "v3-4544eddb",
            "description": "Which skill rules produced this report"
          },
          "suggestions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "update",
                    "create",
                    "verify"
                  ]
                },
                "articleId": {
                  "type": "string",
                  "description": "update / verify: existing article id (or give articleSlug)"
                },
                "articleSlug": {
                  "type": "string",
                  "description": "update / verify: existing article slug"
                },
                "title": {
                  "type": "string",
                  "description": "create: the new article title"
                },
                "categoryId": {
                  "type": "string",
                  "description": "create: existing category id, or \"new:<name>\""
                },
                "draftMarkdown": {
                  "type": "string",
                  "description": "update / create: the FULL article in markdown (max 100 KB)"
                },
                "changedSections": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Headings of the sections the draft changed (\"(intro)\" for text before the first heading)"
                },
                "rationale": {
                  "type": "string",
                  "description": "The sentence that is now wrong, or what a reader now needs"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            "default": [],
            "description": "Empty when nothing in the help center needs to change"
          }
        },
        "required": [
          "ref",
          "title",
          "impactNote",
          "changeClass"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Report a code change",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
