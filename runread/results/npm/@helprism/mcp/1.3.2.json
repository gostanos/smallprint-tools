    {
      "name": "upsert_feature",
      "description": "Beta. Update a feature in the feature map by id (call list_features first for the id), or create one, only for the change you are reporting right now, with codePaths taken from the files in that change, never from memory. A create needs name, summary and codePaths and gets source \"skill\"; an update keeps the feature's source. An unknown id is an error (nothing is created): call list_features first, or omit id to create. Paths only, never code or file contents. Works on Pro and Business.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Existing feature id to update (from list_features); omit to create"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Feature name, e.g. \"Invoice export\""
          },
          "summary": {
            "type": "string",
            "maxLength": 2000,
            "description": "One paragraph in plain language (required to create)"
          },
          "codePaths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "description": "Globs relative to the repository root, e.g. \"src/billing/**\", from the files of the change you are reporting (required to create)"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "description": "Phrases that name the feature in change titles and bodies"
          },
          "articleIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 200,
