      "name": "Get-the-text-of-a-Polish-legal-act-or-of-one-of-its-articles",
      "description": "Get the text of a Polish legal act or of one of its articles",
      "inputSchema": {
        "type": "object",
        "properties": {
          "publisher": {
            "type": "string",
            "enum": [
              "DU",
              "MP"
            ],
            "description": "Journal the act was published in: DU for Dziennik Ustaw or MP for Monitor Polski. The ELI field of a legislative process (get-process, get-passed-processes) such as DU/2024/1 is exactly publisher/year/position, and so is the ELI of acts from search-acts"
          },
          "year": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Year of publication: the middle part of the ELI (2024 in DU/2024/1)"
          },
          "position": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Position in the journal: the last part of the ELI (1 in DU/2024/1)"
          },
          "article": {
            "description": "Return only this article, e.g. 415, 3a or 18^3a for Art. 18 with superscript 3a. Omit to get the whole act, which for codes is over 400,000 characters. The text is the act as published; the current wording of an amended act is in its newest consolidated text (references of type Inf. o tekście jednolitym in get-act)",
            "type": "string",
            "pattern": "^\\d+[a-z]*(\\^[0-9a-z]+|(_[0-9a-z]+)*)$"
          },
          "offset": {
            "description": "Character at which to start; use the offset given at the end of a truncated text to continue",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxLength": {
            "description": "Maximum number of characters to return; defaults to 20000",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 100000
          }
        },
        "required": [
          "publisher",
          "year",
          "position"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
