          "__schema0": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_]+$",
                "description": "machine field key, e.g. 'title' or 'blog_hero'"
              },
              "label": {
                "type": "string",
