    {
      "name": "create_form",
      "description": "Create a form (fields + settings) in the bound project. CONFIRM the fields with the user first. Returns the new form's id — then embed it with `<BcmsForm form={getForm('Name')} />` from @betttercms/next. Field types: text,email,textarea,select(needs options),checkbox,number,phone,date,url,consent,hidden.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "human form name (used by getForm('Name'))"
          },
          "fields": {
            "default": [],
            "description": "the form's fields",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "description": "machine key for the submitted value, e.g. 'email'"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "description": "field label shown to the visitor"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "email",
                    "textarea",
                    "select",
                    "checkbox",
                    "number",
                    "phone",
                    "date",
                    "url",
                    "consent",
                    "hidden"
                  ]
                },
                "placeholder": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "options": {
                  "description": "choices when type is 'select'",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "defaultValue": {
                  "type": "string"
                },
                "showIf": {
                  "description": "show this field only when another field equals a value",
