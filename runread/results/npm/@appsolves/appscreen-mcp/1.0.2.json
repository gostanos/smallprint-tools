    {
      "name": "appscreen_create_screenshot_set",
      "description": "Create a complete multi-screen App Store screenshot set in one call.\n\nUse this for production campaigns with per-screenshot captions, for example 8 screenshots where each asset has different English/German headline and subheadline.\n\nThis tool:\n1. creates a project\n2. sets output size and languages\n3. uploads all screenshots\n4. applies shared background/device/text styling\n5. applies per-screenshot localized captions\n6. optionally exports all screenshots/languages as ZIP\n\nExample screenshot item:\n{\n  \"filePath\": \"C:/screens/shot1.png\",\n  \"name\": \"Home\",\n  \"text\": {\n    \"en\": { \"headline\": \"Control your power\", \"subheadline\": \"Monitor batteries and circuits\" },\n    \"de\": { \"headline\": \"Kontrolliere deinen Strom\", \"subheadline\": \"Überwache Batterien und Stromkreise\" }\n  }\n}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectName": {
            "type": "string",
            "default": "AppScreen Campaign"
          },
          "outputDevice": {
            "type": "string",
            "enum": [
              "iphone-6.9",
              "iphone-6.7",
              "iphone-6.5",
              "iphone-5.5",
              "ipad-12.9",
              "ipad-11",
              "android-phone",
              "android-phone-hd",
              "android-tablet-7",
              "android-tablet-10",
              "web-og",
              "web-twitter",
              "web-hero",
              "web-feature",
              "custom"
            ],
            "default": "iphone-6.9"
          },
          "width": {
