    {
      "name": "appscreen_set_text",
      "description": "Set headline/subheadline text and styling for one screenshot.\n\nImportant:\n- This tool affects only one screenshot: the provided index or the currently selected screenshot.\n- For one language, pass language plus string headline/subheadline.\n- For multiple languages, pass localized maps like { \"en\": \"Title\", \"de\": \"Titel\" }.\n- For 8 different screenshots with different captions, call this once per screenshot, or use appscreen_create_screenshot_set.\n\nExample:\n{\n  \"index\": 0,\n  \"headline\": { \"en\": \"Control your power\", \"de\": \"Kontrolliere deinen Strom\" },\n  \"subheadline\": { \"en\": \"Monitor batteries and circuits\", \"de\": \"Überwache Batterien und Stromkreise\" },\n  \"settings\": { \"position\": \"top\", \"offsetY\": 12 }\n}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "headline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Localized string map keyed by language code. Example: { \"en\": \"Title\", \"de\": \"Titel\" }."
              }
            ]
          },
          "subheadline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/properties/headline/anyOf/1"
              }
            ]
          },
          "language": {
            "type": "string",
            "description": "Language code to use when headline/subheadline are plain strings. Example: en."
          },
          "settings": {
            "type": "object",
            "additionalProperties": {},
            "description": "Text style/settings patch. Common fields: position, offsetY, headlineEnabled, subheadlineEnabled, headlineFontSize, subheadlineFontSize, headlineColor, subheadlineColor, fontFamily.",
            "default": {}
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
