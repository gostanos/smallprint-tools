    {
      "name": "verify_holder_proof",
      "description": "Checks a zero-knowledge proof that someone (for example another agent) holds an active permit in a registry covering the required activities, for your challenge, without learning which permit. The challenge is bound to you: give the holder your `verifier` identity (the URL or service address they reach you at) and a fresh random `nonce`, and pass the same two here. Returns a nullifier: the same holder and challenge always give the same one, and challenges of different verifiers give unrelated ones. Needs o1js; slow the first time.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "network": {
            "type": "string",
            "enum": [
              "devnet",
              "mainnet"
            ],
            "description": "Mina network; defaults to the server's configured network"
          },
          "registry": {
            "type": "string",
            "pattern": "^B62q[1-9A-HJ-NP-Za-km-z]{51}$",
            "description": "Registry address (B62q…)"
          },
          "proof": {
            "type": "object",
            "additionalProperties": {},
            "description": "The proof JSON the holder sent"
          },
          "verifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Your identity as the holder reached you: your origin URL or service address"
          },
          "nonce": {
            "type": "string",
            "pattern": "^\\d{1,76}$",
            "description": "The random number you gave the holder, decimal"
          },
          "requiredScope": {
            "type": "string",
            "pattern": "^\\d{1,80}$",
            "description": "Required scope bits as a decimal bitmask"
          },
          "trustless": {
            "type": "boolean",
            "description": "Read the registry root and current slot from a Mina node instead of the keeper"
          }
        },
        "required": [
          "registry",
          "proof",
          "verifier",
          "nonce"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
