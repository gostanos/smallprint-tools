    {
      "name": "sess_response",
      "description": "Wait a bounded time (default and maximum 45 s; wait_ms 0 reads once) for the answer to exactly this revision. state \"answered\" means the answer passed full Sess receipt verification. state \"needs_resume\" or \"waiting\" means no answer yet: the form stays open; tell the person to submit it and ask you to continue, then call again. state \"expired\" means the link closed with no answer: it is final; create a new form if you still need one. Do not poll in a loop.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "pattern": "^sh_[A-Za-z0-9_-]{22}$",
            "description": "Opaque handle from sess_request."
