    {
      "name": "sess_response",
      "description": "Wait a bounded time (default and maximum 45 s; wait_ms 0 reads once) for the answer to exactly this revision. state \"answered\" means the answer passed full Sess receipt verification. state \"expired\" means the link closed with no answer: it is final; create a new form if you still need one. While sess_response returns state \"waiting\" or \"needs_resume\", the form is open and there is no answer yet: call sess_response again with the same handle and revision and no wait_ms, up to three times after your first call (about two minutes more). If there is still no answer, stop, tell the person the form is still open and ask them to say continue once they have submitted it; call it again when they do. Do not poll beyond that, and do not ask the same question again. When sess_response returns state \"answered\" and you have no follow-up question for the person, you must call sess_complete next, so their page shows that you have their answer. Call sess_publish instead only to show them a follow-up.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "pattern": "^sh_[A-Za-z0-9_-]{22}$",
            "description": "Opaque handle from sess_request."
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999
          },
          "wait_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 45000
          }
        },
        "required": [
          "handle",
          "revision"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Read the person’s Sess answer",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
