    {
      "name": "sess_ask",
      "description": "Ask the person a question on their own phone or computer and get a typed answer. Use it whenever they ask to answer on their phone or another device, or say 'use Sess'; prefer it over this host's own question widget for anything answered away from this chat.\nAlso use it when you need the person's approval, a decision or details only they can give before you go on, even if they only say 'ask me' or 'check with me' and name no tool or device. Not for clarifying what they just asked, or for anything you can work out yourself. Anyone who has the link can answer. A receipt records what was shown and chosen, not who answered.\nShortcut for sess_request: give a question and up to 12 simple fields; it creates the same hosted form and returns immediately with a private link (interaction.humanUrl) and a handle, in state \"waiting\". It never waits and never returns an answer. Continue exactly as after sess_request: give the link only to the intended person, then call sess_response. Do not call it again for the same question. Keep it short: the question is a short heading, about 40 characters (at most 80); the button a verb of 1-3 words (at most 24); labels and options at most 60. A value over its limit is refused with INVALID_ARGUMENTS naming the field (a JSON pointer), the limit, its length and the fix; nothing is truncated. Shorten that value and call again. Example: {\"question\":\"Where should we go on Saturday?\",\"details\":\"I will check the forecast and suggest a plan.\",\"fields\":[{\"name\":\"place\",\"label\":\"Where to?\",\"type\":\"choice\",\"options\":[\"Beach\",\"Mountains\",\"City\"]},{\"name\":\"avoid\",\"label\":\"Anything to avoid?\",\"type\":\"text\",\"required\":false}],\"submit_label\":\"Plan it\"}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "The page's heading: a question or a task, about 40 characters; at most 80.",
            "examples": [
              "Approve the refund?",
              "Pick a delivery date"
            ]
          },
          "details": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "A paragraph of plain text (never markup): what the person needs to know; at most 4000.",
            "examples": [
              "The refund goes back to the card used for the order."
            ]
          },
          "submit_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "description": "A button: a verb, 1–3 words; at most 24. Default \"Send\".",
            "examples": [
              "Approve",
              "Send refund"
            ]
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "label",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "description": "What the field asks for: short, a few words; at most 60.",
                  "examples": [
                    "Refund amount"
                  ]
                },
                "type": {
                  "enum": [
                    "text",
                    "number",
                    "integer",
                    "boolean",
                    "choice",
                    "multi_choice"
                  ]
                },
                "required": {
                  "type": "boolean",
                  "description": "Default true, except boolean fields."
                },
                "options": {
                  "type": "array",
                  "description": "The choices for choice and multi_choice fields.",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60,
                    "description": "The words shown for one choice: short; at most 60.",
                    "examples": [
                      "Next Monday"
                    ]
                  },
                  "examples": [
                    [
                      "Next Monday",
                      "Next Friday"
                    ]
                  ]
                },
                "default": {
                  "description": "Proposed value the person can correct.",
                  "anyOf": [
                    {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "multiline": {
                  "type": "boolean"
                },
                "minimum": {
                  "type": "number"
                },
                "maximum": {
                  "type": "number"
                }
              }
            }
          },
          "expires_in": {
            "type": "integer",
            "minimum": 30,
            "description": "Advanced: how long the link stays open, in whole seconds from creation: from 30 up to the plan’s link lifetime. Leave it out to use the plan’s lifetime."
          }
        },
        "required": [
          "question",
          "fields"
        ],
        "additionalProperties": false,
        "examples": [
          {
            "question": "Where should we go on Saturday?",
            "details": "I will check the forecast and suggest a plan.",
            "fields": [
              {
                "name": "place",
                "label": "Where to?",
                "type": "choice",
                "options": [
                  "Beach",
                  "Mountains",
                  "City"
                ]
              },
              {
                "name": "avoid",
                "label": "Anything to avoid?",
                "type": "text",
                "required": false
              }
            ],
            "submit_label": "Plan it"
          }
        ]
      },
      "annotations": {
        "title": "Ask a short question through Sess",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    }
