    {
      "name": "query_gaql",
      "description": "Runs one Google Ads Query Language SELECT on one account. Read-only: anything but a single SELECT on a known resource is refused. LIMIT is added (200) or lowered (max 1000). Returns a summary first, then up to max_rows rows; next_cursor fetches the rest. Costs 1 Google Ads operation per call.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Google Ads customer id, e.g. 123-456-7890 (see list_accounts)"
          },
          "query": {
            "type": "string",
            "description": "One GAQL SELECT, e.g. SELECT campaign.name, metrics.clicks FROM campaign WHERE segments.date DURING LAST_7_DAYS. LIMIT defaults to 200, max 1000."
          },
          "max_rows": {
            "description": "Rows to return in this reply (default 50). The rest come with next_cursor.",
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "cursor": {
            "description": "next_cursor from the previous reply, with the same query and customer_id",
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "customer_id",
          "query"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "title": "Run a read-only GAQL query",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
