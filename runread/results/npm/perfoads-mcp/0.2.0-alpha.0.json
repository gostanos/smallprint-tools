    {
      "name": "build_snapshot",
      "description": "Reads everything the checks need (90 days) into a saved snapshot (kept 24 h; a complete one under 60 min old is reused unless refresh:true). Returns its id and how each read went; failed or cut reads are said. Then run_checks. Example: {\"customer_id\":\"123-456-7890\"}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "e.g. 123-456-7890"
          },
          "refresh": {
            "description": "true = read again, never reuse a kept one",
            "type": "boolean"
          },
          "checks": {
            "description": "Read only what these checks need, e.g. [\"BB02\"] (default all)",
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 10
            }
          }
        },
        "required": [
          "customer_id"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "title": "Build account snapshot",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
