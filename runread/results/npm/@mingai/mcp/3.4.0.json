              "default",
              "more",
              "full"
            ],
            "description": "输出细节级别。",
            "default": "default"
          }
        },
        "required": [
          "birthYear",
          "birthMonth",
          "birthDay",
          "birthHour"
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "latitude"
              ]
            },
            "then": {
              "required": [
                "longitude"
              ]
            }
          },
          {
            "if": {
              "required": [
                "longitude"
              ]
            },
            "then": {
              "required": [
                "latitude"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "detailLevel": {
                  "const": "full"
                }
              },
              "required": [
                "detailLevel"
              ]
            },
            "then": {
              "required": [
                "latitude",
                "longitude"
              ]
            }
          }
        ],
