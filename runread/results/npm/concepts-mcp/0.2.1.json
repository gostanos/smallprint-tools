            "description": "Absolute path of the repository root. Defaults to the server's working directory.",
            "type": "string",
            "maxLength": 2000
          },
          "destinations": {
            "description": "One entry per folder. Omit to show the user a picker.",
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "output": {
                  "type": "string",
                  "enum": [
                    "project",
                    "library"
                  ],
                  "description": "project = a folder in the repo; library = the user's learning library on this computer"
