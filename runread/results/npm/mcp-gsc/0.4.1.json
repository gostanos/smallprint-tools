    {
      "name": "search_analytics",
      "description": "Query Google Search Console search performance data (clicks, impressions, CTR, position) with filtering and grouping.\n\nDIMENSIONS: query, page, country, device, date, searchAppearance, hour\n- \"hour\" requires data_state=\"hourly_all\" and is limited to the last 10 days\n- \"searchAppearance\" CANNOT be combined with \"query\" or \"page\" (API restriction)\n\nTYPE: web (default), image, video, news, discover, googleNews\n- \"discover\" = Google Discover feed. \"googleNews\" = Google News tab (distinct from \"news\")\n\nDATA STATE: Controls data freshness.\n- \"all\" (default) includes recent incomplete data matching the GSC dashboard\n- \"final\" returns only confirmed data with a 2-3 day lag, useful for stable reporting\n- \"hourly_all\" enables hourly granularity but data may be incomplete for the current day\n\nBRAND FILTER: Set to \"brand_only\" or \"non_brand_only\" to auto-filter queries by your domain name.\n\nCountry codes use ISO 3166-1 alpha-3 format (e.g., 'usa', 'gbr', 'deu') — NOT alpha-2.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "site_url": {
            "description": "GSC property URL. Defaults to GOOGLE_GSC_PROPERTY env var. Accepts bare domain (auto-resolved).",
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "description": "Start date in YYYY-MM-DD format"
          },
          "end_date": {
            "type": "string",
            "description": "End date in YYYY-MM-DD format"
          },
          "dimensions": {
            "description": "Dimensions to group results by",
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "query",
                "page",
                "country",
                "device",
                "date",
                "searchAppearance",
                "hour"
              ]
            }
          },
          "type": {
            "description": "Search type (default: web)",
            "type": "string",
            "enum": [
              "web",
              "image",
              "video",
              "news",
              "discover",
              "googleNews"
            ]
          },
          "data_state": {
            "description": "Data freshness (default: all)",
            "type": "string",
            "enum": [
              "all",
              "final",
              "hourly_all"
            ]
          },
          "dimension_filters": {
            "description": "Filters to apply to the query",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "dimension": {
                  "type": "string",
                  "enum": [
                    "query",
                    "page",
                    "country",
                    "device",
                    "searchAppearance"
                  ]
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "equals",
                    "notEquals",
                    "contains",
                    "notContains",
                    "includingRegex",
                    "excludingRegex"
                  ]
                },
                "expression": {
                  "type": "string",
                  "description": "Filter value. For country, use ISO 3166-1 alpha-3 codes (e.g., 'usa', 'gbr', 'deu') — NOT alpha-2"
                }
              },
              "required": [
                "dimension",
                "operator",
                "expression"
              ]
            }
          },
          "row_limit": {
            "description": "Max rows to return (default: 100, max: 25000 — the Search Analytics API ceiling). Raise it to reach the long tail; large values produce large responses",
            "type": "number",
            "minimum": 1,
            "maximum": 25000
          },
          "start_row": {
            "description": "0-based offset for pagination",
            "type": "number",
            "minimum": 0
          },
          "brand_filter": {
            "description": "Auto-filter queries by domain name. brand_only = queries containing your brand, non_brand_only = queries without",
            "type": "string",
            "enum": [
              "brand_only",
              "non_brand_only"
            ]
          }
        },
        "required": [
          "start_date",
          "end_date"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
