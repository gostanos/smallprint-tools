    {
      "name": "superskill",
      "description": "SuperSkill is your runtime skill router — it picks the right methodology from your installed skills and loads it on demand.\n\nWorks with skills installed via `npx skills add` (skills.sh) or the built-in catalog. Covers: Test-Driven Development, Planning, Code Review, Debugging, Verification, Brainstorming, Agent Orchestration, Security, Shipping, Frontend Design, Git Workflow, Go, Python, Django, Spring Boot, Swift, C++, Java, Database, Docker, API Design, Frontend Patterns, Backend Patterns, Coding Standards, Content & Business, 3D Animation, Agent Engineering, Meta/Tooling.\n\nDescribe the task and SuperSkill finds the best matching skill. Don't overthink domain selection — just describe what you need.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "description": "Describe what you're doing — SuperSkill finds the right methodology. This is the primary input."
          },
          "domain": {
            "type": "string",
            "description": "Optional: pass domain(s) directly if you know them. Comma-separate for multiple: 'planning,security'"
          },
          "skill_id": {
            "type": "string",
            "description": "Load a specific skill by ID (e.g. 'ecc/tdd-workflow'). For precise control."
          },
          "action": {
            "type": "string",
            "enum": [
              "activate",
              "manifest",
              "load"
            ],
            "description": "Action: activate (default), manifest (list all), load (by skill_id)"
          },
          "profile": {
            "type": "string",
            "description": "Profile: ecc-first, superpowers-first, minimal. Auto-detected if omitted."
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
