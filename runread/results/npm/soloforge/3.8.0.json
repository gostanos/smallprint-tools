        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "sf_governance_effectiveness",
      "description": "查询 governance 治理有效性指标(只读:totalGenerated/totalRequirements/requirementCompletionRate/policyEffectiveness/failureRate)。不泄露 governanceResult。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "sf_governance_fulfillment",
      "description": "查询 governance requirement 完成状态(只读:requirements[{requirementId,status,evidenceCount}])。不泄露 governanceResult。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "sf_requirement",
      "description": "RequirementContract 生命周期入口(create/list/query)。所有写入经 RequirementStore(HMAC 签名,fail-closed)。manual 需求创建;governance 需求经 bridge 自动落 store。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "list",
              "query"
            ],
            "description": "create=创建 manual requirement;list=按 task 列出;query=按 id 查状态"
          },
          "task_id": {
            "type": "string",
            "description": "create/list 必填:所属任务 id"
          },
          "requirement_id": {
            "type": "string",
            "description": "query 必填:requirement id(req-xxx)"
          },
          "description": {
            "type": "string",
            "description": "create 必填:需求描述"
          },
          "priority": {
            "type": "string",
            "enum": [
              "must",
              "should",
              "could",
              "wont"
            ],
            "description": "MoSCoW 优先级,默认 must"
          },
          "affected_domains": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "design",
                "build",
                "verify",
                "operate"
              ]
            },
            "description": "影响域,默认 [design]"
          },
          "evidence_requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "artifact_kind": {
                  "type": "string"
                },
                "domain": {
                  "type": "string",
                  "enum": [
                    "design",
                    "build",
                    "verify",
                    "operate"
                  ]
                }
              },
              "required": [
                "artifact_kind",
                "domain"
              ],
              "additionalProperties": false
            },
            "description": "证据要求(产物 kind + domain)"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "criterion_id": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "artifact_kind": {
                  "type": "string"
                },
                "domain": {
                  "type": "string",
                  "enum": [
                    "design",
                    "build",
                    "verify",
                    "operate"
                  ]
                }
              },
              "required": [
                "criterion_id",
                "description",
                "artifact_kind",
                "domain"
              ],
              "additionalProperties": false
            },
            "description": "验收标准(绑定 artifact_kind/domain,coverage 验证)"
          },
          "confirm": {
            "type": "boolean",
            "description": "create 必须传 true(list/query 免确认)"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "sf_waiver",
      "description": "豁免与基线生命周期入口。create/list/revoke:豁免(individual 个案默认;structural 跨任务四锁——conflict_source/expires_at/approved_by/category+每类上限)。baseline_register/reduce/remove/list:存量债务基线(计数锁——违例≤登记放行标注,超出即红;只减不增,调增=门禁变更须 increase_action)。写操作需 confirm=true;non_waivable check 拒绝(含 structural 化)。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "list",
              "revoke",
              "baseline_register",
              "baseline_reduce",
              "baseline_remove",
              "baseline_list"
            ],
            "description": "create=创建豁免;list=列 active 豁免;revoke=撤销豁免"
          },
          "task_id": {
            "type": "string",
            "description": "create 必填:所属任务 id(豁免不跨任务复用)"
          },
          "domain": {
            "type": "string",
            "enum": [
              "design",
              "build",
              "verify",
              "operate"
            ],
            "description": "create 必填/list 可选:所属域"
          },
          "check_id": {
            "type": "string",
            "description": "create 必填:被豁免的 check id(如 TS-Q01)"
          },
          "scope": {
            "type": "string",
            "enum": [
              "exact",
              "check_id"
            ],
            "description": "豁免范围,默认 exact(须配合 artifact_path);check_id=该 check 在该域全部产物(每域≤3)"
          },
          "artifact_path": {
            "type": "string",
            "description": "scope=exact 必填:产物路径"
          },
          "finding_location": {
            "type": "string",
            "description": "finding 级豁免:只豁免该位置,check 其他 finding 仍查"
          },
          "reason": {
            "type": "string",
            "description": "create 必填(≥10 字符)/revoke 可选:豁免或撤销理由,审计留痕"
          },
          "waiver_id": {
            "type": "string",
            "description": "revoke 必填:waiver id"
          },
          "waiver_type": {
            "type": "string",
            "enum": [
              "individual",
              "structural"
            ],
            "description": "豁免物种:individual=现状个案(默认);structural=跨任务结构性豁免(四锁:conflict_source/expires_at/approved_by/category+每类上限)"
          },
          "conflict_source": {
            "type": "string",
            "minLength": 3,
            "description": "structural 必填:矛盾源锚定(如 artifact:prototype_spec:docs/analyze——锚矛盾源而非被验证产物)"
          },
          "expires_at": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "structural 必填:过期时间戳(未来;过期即失效不自动续期)"
          },
          "approved_by": {
            "type": "string",
            "const": "user",
            "description": "structural 必填:批准人(恒 user——人工批准,AI 不得自批)"
          },
          "category": {
            "type": "string",
            "minLength": 2,
            "description": "structural 必填:分类(如 legacy-prototype/parallel-batch,doctor 聚类展示用)"
          },
          "path_pattern": {
            "type": "string",
            "minLength": 1,
            "description": "baseline_register 必填:违例范围路径模式"
          },
          "registered_count": {
            "type": "integer",
            "minimum": 0,
            "description": "baseline_register/baseline_reduce:登记的存量违例数(计数锁;reduce 调增须 increase_action=true+reason)"
          },
          "baseline_id": {
            "type": "string",
            "description": "baseline_reduce/baseline_remove 必填:基线 id"
          },
          "cleanup_ref": {
            "type": "string",
            "description": "baseline_register 可选:清理专项挂钩(关联任务/批次说明)"
          },
          "increase_action": {
            "type": "boolean",
            "description": "baseline_reduce 调增时必须 true(调增=门禁变更,审计留痕);减少(清偿)无需"
          },
          "confirm": {
            "type": "boolean",
            "description": "create/revoke/baseline_* 写操作必须传 true(list/baseline_list 免确认)"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
