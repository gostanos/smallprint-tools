              },
              "task_id": {
                "type": "string"
              },
              "layer": {
                "type": "string",
                "enum": [
                  "build",
                  "test",
                  "requirement",
                  "code_quality"
                ]
              },
              "passed": {
                "type": "boolean"
              },
              "failures": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "error_type": {
                      "type": "string",
                      "enum": [
                        "compile_error",
                        "test_failure",
                        "empty_test_suite",
                        "hollow_command",
                        "requirement_not_covered",
                        "quality_violation"
                      ]
                    },
                    "reason": {
                      "type": "string"
                    },
                    "file": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error_type",
                    "reason"
                  ],
                  "additionalProperties": true
                }
              },
              "duration_ms": {
                "type": "number"
              },
              "verified_at": {
                "type": "number"
              }
            },
            "required": [
              "verification_id",
              "task_id",
              "layer",
              "passed",
              "failures",
              "duration_ms",
              "verified_at"
            ],
            "additionalProperties": true,
            "description": "VerificationResult(含 failures)"
          },
          "related_steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step_id": {
                  "type": "string"
                },
                "target_file": {
                  "type": "string"
                }
              },
              "required": [
                "step_id",
                "target_file"
              ],
              "additionalProperties": true
            },
            "description": "关联 ExecutionStep(失败文件定位,可选,默认空)"
          }
        },
        "required": [
          "verification_result"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "sf_execute",
      "description": "V2:验证 task(假设 AI 已按 plan 编辑文件)。跑 command verification(command evidence → EvidenceStore),供 deliver 消费。不编辑文件/不接 repair loop/不写 EvidenceView。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^task-[a-f0-9]{8}$",
            "description": "任务 ID"
          },
          "plan_id": {
            "type": "string",
            "description": "ExecutionPlan ID(sf_plan 产出)"
          },
          "layer": {
            "type": "string",
            "enum": [
              "build",
              "test"
            ],
            "description": "验证层(默认 test)"
          },
          "verification_contract": {
            "type": "object",
            "properties": {
              "build_commands": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "command": {
                      "type": "string"
                    },
                    "layer": {
                      "type": "string",
                      "enum": [
                        "build",
                        "test"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "command",
                    "layer"
                  ],
                  "additionalProperties": true
                }
              },
              "test_commands": {
                "type": "array",
                "items": {
                  "$ref": "#/properties/verification_contract/properties/build_commands/items"
                }
              },
              "allowed_commands": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "working_directory": {
                "type": "string"
              },
              "environment_requirements": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "working_directory"
            ],
            "additionalProperties": true,
            "description": "项目执行契约(build/test 命令 + working_directory)"
          }
        },
        "required": [
          "task_id",
          "plan_id",
          "verification_contract"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "sf_evidence_graph",
      "description": "只读查询 task 的证据图摘要(Finding→Resolution→Artifact):findings/resolutions/artifacts/unresolvedCount。经 EvidenceGraphView 读 store,不改任何 record,不触发验证。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "description": "任务 id(查该 task 的证据图:涉及的 finding/resolution/artifact 与未闭环数)"
          }
        },
        "required": [
          "task_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "sf_governance_history",
      "description": "查询 governance 决策审计摘要(只读,返回 id/taskId/status/policyIds/requirementIds/createdAt)。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "按 taskId 过滤(可选)"
          }
