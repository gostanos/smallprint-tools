        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "sf_governance_report",
      "description": "查询 governance 覆盖率报告(只读聚合:totalDecisions/generated/failed/policyUsage/requirementUsage/skipped)。",
      "inputSchema": {
