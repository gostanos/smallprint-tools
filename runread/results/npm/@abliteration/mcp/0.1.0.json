    {
      "name": "search_models",
      "description": "Search the abliteration.org catalog of abliterated and uncensored LLMs (GET /models). Filter by M-code method, base family, author, license, download range and creation date. Delisted models are excluded unless delisted=dead|all. Cost: 5 credits up to 200 rows; 20 / 80 / 300 for larger pages, multiplied by 1 + (offset/2500)^2. Filter narrowly rather than paging deep.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "method": {
            "description": "M-code, case-insensitive, e.g. M4. See list_methods.",
            "type": "string"
          },
          "family": {
            "description": "Base family, e.g. qwen or llama.",
            "type": "string"
          },
          "author": {
            "description": "Publisher handle, case-insensitive.",
            "type": "string"
          },
          "license": {
            "description": "SPDX-ish license string as published.",
            "type": "string"
          },
          "downloads_gte": {
            "description": "Minimum downloads.",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "downloads_lte": {
            "description": "Maximum downloads.",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "created_after": {
            "description": "ISO-8601 date or timestamp, inclusive.",
            "type": "string"
          },
          "created_before": {
            "description": "ISO-8601 date or timestamp, inclusive.",
            "type": "string"
          },
          "delisted": {
            "description": "live (default): on the Hub now. dead: delisted only. all: both.",
            "type": "string",
            "enum": [
              "live",
              "dead",
              "all"
            ]
          },
          "sort": {
            "description": "Bare key is the natural direction (most / newest first); a leading - flips it. Default downloads.",
            "type": "string",
            "enum": [
              "downloads",
              "-downloads",
              "likes",
              "-likes",
              "created",
              "-created",
              "created_at",
              "-created_at",
              "first_seen",
              "-first_seen",
              "first_seen_at",
              "-first_seen_at"
            ]
          },
          "limit": {
            "description": "Rows to return, 1 to 1000. Default 50.",
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "offset": {
            "description": "Rows to skip. Default 0.",
            "type": "integer",
            "minimum": 0,
