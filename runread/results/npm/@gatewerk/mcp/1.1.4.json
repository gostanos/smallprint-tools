    {
      "name": "gatewerk_create_review",
      "description": "Submit a review request for human oversight. Returns the created review with its ID and status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "template": {
            "type": "string",
            "description": "Template slug (e.g., 'email-review', 'code-deploy')"
          },
          "payload": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "Data fields matching the template schema. Call gatewerk_list_templates first to discover the field names and types for your chosen template."
          },
          "callback_url": {
            "description": "Webhook URL to receive the review decision. Optional — agents using MCP often don't have a webhook and can poll gatewerk_get_review or wait for tool re-invocation.",
            "type": "string",
            "format": "uri"
          },
          "priority": {
            "description": "Review priority",
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high",
              "critical"
            ]
          },
          "assignee": {
            "description": "Assign to specific reviewer (email)",
            "type": "string"
          },
          "metadata": {
            "description": "Arbitrary metadata for agent context",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "timeout": {
            "description": "Auto-expiry policy",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "auto_approve",
                  "auto_reject",
                  "expire"
                ]
              },
              "seconds": {
                "type": "number"
              }
            },
            "required": [
              "action",
              "seconds"
            ]
          },
          "idempotency_key": {
            "description": "Unique key scoped to the project. A second call with the same key returns the existing review instead of creating a duplicate. Useful for LangGraph node replays and agent retries.",
            "type": "string"
          }
        },
        "required": [
          "template",
          "payload"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
