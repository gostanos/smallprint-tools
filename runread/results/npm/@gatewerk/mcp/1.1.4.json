    {
      "name": "gatewerk_take_review_action",
      "description": "Invoke a configurable action on a review. Supersedes gatewerk_decide_review for templates with custom actions. Built-in action_ids: 'approve', 'reject', 'request_changes', 'cancel_iteration'. Custom action_ids are template-specific — use gatewerk_list_review_actions to introspect available actions. Supports both session and api-key (agent) authentication.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "review_id": {
            "type": "string",
            "description": "Review ID (gw_rev_...)"
          },
          "action_id": {
            "type": "string",
            "minLength": 1,
            "description": "Action identifier as configured on the template"
          },
          "feedback": {
            "description": "Required for actions with requires_feedback=true; optional otherwise",
            "type": "string"
          },
          "edited_payload": {
            "description": "Modified payload (for edit-on-approve flows)",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "version": {
            "description": "Optimistic-concurrency guard for edited_payload submissions",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "review_id",
          "action_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
