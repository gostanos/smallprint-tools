      }
    },
    {
      "name": "naver_update_stock",
      "description": "Change stock quantity of a product or its options. For a product WITHOUT options pass channelProductNo + stockQuantity; for a product WITH options pass originProductNo + options[]. 상품/옵션 재고를 변경합니다. IRREVERSIBLE: changes the live store. Needs channelProductNo (no-option) or originProductNo (option product); both come from naver_list_products.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channelProductNo": {
            "type": "integer",
            "description": "Channel product number — required for a product without options"
          },
          "originProductNo": {
            "type": "integer",
            "description": "Origin product number — required for a product with options"
          },
          "stockQuantity": {
            "type": "integer",
            "minimum": 0,
            "description": "New stock for a product without options"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "description": "Option id (optionCombinations[].id)"
