                "default": {},
                "description": "That type's fields. For ETC: itemName, modelName, manufacturer, afterServiceDirector (+ certificationType etc.). '상세페이지 참조' is accepted for most."
              }
            },
            "additionalProperties": false,
            "default": {}
          },
          "minorPurchasable": {
            "type": "boolean",
            "default": true
          },
          "sellerManagementCode": {
            "type": "string",
            "description": "판매자 관리코드 (SKU)"
          },
          "brandName": {
            "type": "string"
          },
          "manufacturerName": {
            "type": "string"
          },
          "naverShoppingRegistration": {
            "type": "boolean",
            "default": true
          },
          "maxPurchaseQuantityPerOrder": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "required": [
