            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 50,
            "description": "Items per page (max 500)"
          },
          "productStatusTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "WAIT",
                "SALE",
                "OUTOFSTOCK",
                "UNADMISSION",
                "REJECTION",
                "SUSPENSION",
                "CLOSE",
                "PROHIBITION",
                "DELETE"
              ]
