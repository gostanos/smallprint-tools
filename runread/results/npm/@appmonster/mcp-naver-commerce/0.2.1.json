    {
      "name": "naver_create_product",
      "description": "Create a new Smart Store product (origin product + smartstore channel product) and put it on sale. Accepts the draft shape from jp_listing_draft. Images must already be Naver-hosted (naver_upload_images). Returns originProductNo and channelProductNo. 스마트스토어에 새 상품을 등록합니다. IRREVERSIBLE: goes live immediately unless statusType is SUSPENSION. Needs leafCategoryId, name, detailContent, salePrice, stockQuantity, representative image URL, origin (원산지), A/S info, and 상품정보제공고시.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "leafCategoryId": {
            "type": "string",
            "minLength": 1,
            "description": "Naver leaf category id (리프 카테고리), e.g. 50000803"
          },
          "detailContent": {
            "type": "string",
            "minLength": 1,
            "description": "HTML or text detail page content"
          },
          "salePrice": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "KRW, multiple of 10"
          },
          "stockQuantity": {
            "type": "integer",
            "minimum": 0
          },
          "representativeImageUrl": {
            "type": "string",
            "format": "uri",
            "description": "Naver-hosted URL from naver_upload_images"
          },
          "optionalImageUrls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "maxItems": 9
          },
          "statusType": {
            "type": "string",
            "enum": [
              "SALE",
              "SUSPENSION",
              "WAIT"
            ],
            "default": "SALE",
            "description": "SALE = live now. SUSPENSION = 판매중지: created but not purchasable, review in 스마트스토어센터 then switch to SALE. (WAIT is accepted as an alias of SUSPENSION — Naver rejects WAIT on create, verified live.)"
          },
          "saleType": {
            "type": "string",
            "enum": [
              "NEW",
              "OLD"
            ],
            "default": "NEW"
          },
          "originArea": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "default": "03",
                "description": "원산지 코드: 00 국산, 03 수입산(해외구매대행 포함), 04 기타"
              },
              "content": {
                "type": "string",
                "description": "e.g. 일본"
              },
              "importer": {
                "type": "string",
                "description": "수입사/구매대행 표기"
              }
            },
            "additionalProperties": false,
            "default": {
              "code": "03"
            }
          },
          "afterService": {
            "type": "object",
            "properties": {
              "telephone": {
                "type": "string",
                "minLength": 1
              },
              "guide": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "telephone",
              "guide"
            ],
            "additionalProperties": false
          },
          "delivery": {
            "type": "object",
            "properties": {
              "deliveryFeeType": {
                "type": "string",
                "enum": [
                  "FREE",
                  "PAID",
                  "CONDITIONAL_FREE"
                ],
                "default": "FREE"
              },
              "baseFee": {
                "type": "integer",
                "minimum": 0,
                "description": "PAID/CONDITIONAL_FREE 배송비"
              },
              "freeConditionalAmount": {
                "type": "integer",
                "minimum": 0,
                "description": "CONDITIONAL_FREE 기준 금액"
              },
              "returnDeliveryFee": {
                "type": "integer",
                "minimum": 0,
                "default": 3000
              },
              "exchangeDeliveryFee": {
                "type": "integer",
                "minimum": 0,
                "default": 6000
              },
              "deliveryAttributeType": {
                "type": "string",
                "enum": [
                  "NORMAL",
                  "TODAY",
                  "OPTION_TODAY",
                  "HOPE",
                  "ORDER_MAKE",
                  "SELLER_GUARANTEE"
                ],
                "default": "NORMAL"
              },
              "deliveryCompany": {
                "type": "string",
                "default": "CJGLS",
                "description": "택배사 코드 — required by Naver for parcel delivery (verified live). CJGLS=CJ대한통운, HYUNDAI=롯데택배, HANJIN=한진택배, KGB=로젠택배, EPOST=우체국택배, KDEXP=경동택배"
              }
            },
            "additionalProperties": false,
            "default": {}
          },
          "notice": {
            "type": "object",
            "properties": {
              "productInfoProvidedNoticeType": {
                "type": "string",
                "default": "ETC",
                "description": "고시 유형 코드, e.g. ETC(기타), WEAR(의류), FOOD, ELECTRONICS…"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
