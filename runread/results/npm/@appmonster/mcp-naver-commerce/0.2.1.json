          "lastChangedTo": {
            "type": "string",
            "description": "ISO 8601 datetime; default = now"
          },
          "lastChangedType": {
            "type": "string",
            "enum": [
              "PAY_WAITING",
              "PAYED",
              "EXCHANGE_OPTION",
              "DELIVERY_ADDRESS_CHANGED",
              "GIFT_RECEIVED",
              "CLAIM_REJECTED",
              "DISPATCHED",
              "CLAIM_REQUESTED",
              "COLLECT_DONE",
              "CLAIM_HOLDBACK_RELEASED",
              "CLAIM_COMPLETED",
              "PURCHASE_DECIDED",
              "HOPE_DELIVERY_INFO_CHANGED",
              "CLAIM_REDELIVERING"
            ],
            "description": "Filter by change type, e.g. PAYED for newly paid orders"
          },
          "withDetails": {
            "type": "boolean",
            "default": true,
            "description": "Also fetch order details (buyer, product, amounts) for the returned productOrderIds"
