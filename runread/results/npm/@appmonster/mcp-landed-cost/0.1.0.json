  "status": "tools",
  "tools": [
    {
      "name": "landed_cost",
      "description": "Estimate what a buyer pays to import a parcel: goods + shipping + customs duty + import VAT/GST, for US, UK, EU (27 states), Japan, Korea, China, Australia, Canada and Singapore. Applies current de minimis rules (EU €3 duty on ≤€150 parcels from Jul 2026, US de minimis suspended, UK ≤£135, Japan ¥10,000, Korea $150/$200, AU A$1,000…) and says what is collected at checkout. Duty rates depend on the product's HS code — pass dutyRate when known.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string",
            "pattern": "^[A-Za-z]{2}$",
            "description": "Destination country ISO2: US, GB, DE, FR, JP, KR, CN, AU, CA, SG, any EU member"
          },
          "origin": {
            "type": "string",
            "pattern": "^[A-Za-z]{2}$",
            "description": "Origin country ISO2 (matters for Canada CUSMA, Korea US threshold)"
          },
          "goodsValue": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000000,
            "description": "Price of the goods"
          },
          "shipping": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000,
            "default": 0,
            "description": "International shipping charged"
          },
          "insurance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000,
            "default": 0
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "default": "USD",
            "description": "Currency of goodsValue/shipping (ISO 4217)"
          },
          "dutyRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 5,
            "description": "Product duty rate as a decimal (0.08 = 8%) incl. any extra tariffs. Omit if unknown."
          },
          "itemCategories": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 1,
            "description": "Number of distinct product types in the parcel (EU flat duty is per category)"
          },
          "buyer": {
            "type": "string",
            "enum": [
              "consumer",
              "business"
            ],
            "default": "consumer"
          },
          "vatRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.5,
            "description": "Override VAT/GST rate (e.g. Canadian HST 0.13)"
          },
          "fxRate": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Units of destination currency per 1 unit of currency (skip live FX)"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Import date for dated rules (default today)"
          }
        },
        "required": [
          "destination",
          "goodsValue"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "landed_cost_rules",
      "description": "Show the import tax rules used for a destination (or all): currency, VAT/GST rate, de minimis thresholds and upcoming changes, with sources and the date they were last checked.",
