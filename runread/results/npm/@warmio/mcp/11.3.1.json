    {
      "name": "get_transactions",
      "description": "Read-only transactions from the FinancialContext artifact. Pass exactly one of `period` or `periods`. Use `period: \"latest\"` for the fixed 10-day window, `period: \"YYYY-MM\"` for one month, or `periods` for two or three distinct months. Multi-month output contains one month page per requested period in input order. The latest window is not caller-configurable. Months outside the covered range return an error.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "period": {
            "anyOf": [
              {
                "type": "string",
                "const": "latest"
              },
              {
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              }
            ],
            "description": "Use \"latest\" for the fixed 10-day window or a YYYY-MM month when periods is not provided. A month outside the covered range returns an error."
          },
          "periods": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            },
            "minItems": 2,
            "maxItems": 3,
            "description": "Use two or three distinct YYYY-MM months for one read. Pass periods instead of period. Months outside the covered range return an error."
          }
        },
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft-07/schema#"
      },
