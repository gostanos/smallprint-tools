    {
      "name": "setup_companion_skill",
      "description": "检查或安装与本 MCP 配套的找客户 Agent Skill。首次使用找客户前先调用 action=status（只读）；如果返回 missing/outdated，必须先向用户说明目标目录并取得明确同意，之后才可调用 action=install、指定当前宿主 target 并传 confirm=true。严禁未经用户同意安装或更新 Skill。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "status",
              "install"
            ],
            "description": "status=只读检查；install=在用户明确同意后安装或更新。默认 status。"
          },
          "target": {
            "type": "string",
            "enum": [
              "auto",
              "codex",
              "cursor",
              "claude",
              "agents",
              "workbuddy"
            ],
            "description": "当前智能体宿主。自动检测不唯一时必须明确指定，不能同时安装到多个宿主。"
          },
          "confirm": {
            "type": "boolean",
            "description": "只有用户已经明确同意写入显示的 Skill 目录时才传 true。status 不需要。"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "检查或安装配套找客户 Skill",
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
