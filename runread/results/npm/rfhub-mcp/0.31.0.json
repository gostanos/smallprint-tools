    {
      "name": "arfcn_calculator_4g_compute",
      "description": "支持4G LTE网络中频率与频点之间的相互转换，并附带特定频段的详细信息展示",
      "inputSchema": {
        "type": "object",
        "properties": {
          "Mode": {
            "x-order": 10,
            "title": "计算模式",
            "description": "当前函数的计算模型，是选择以频点模式还是频率模式进行计算，直接关乎于后续参数的选择",
            "example": "n",
            "type": "string",
            "enum": [
              "n",
              "f"
            ],
            "x-enum-labels": {
              "n": "提供频点进行后续换算",
              "f": "提供频率进行后续换算"
            }
          },
          "DataTransmissionDirection": {
            "type": "string",
            "enum": [
              "uplink",
              "downlink"
            ],
            "x-enum-labels": {
              "uplink": "上行方向",
              "downlink": "下行方向"
            },
            "x-order": 20,
            "title": "数据传输方向",
            "example": "downlink",
            "description": "数据传输方向，是上行还是下行"
          },
          "NREF": {
            "x-order": 30,
            "title": "中心频点",
            "example": 100,
            "description": "4G/LTE标准中心频点",
            "x-required-when": "Mode === \"n\"",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "FREF": {
            "x-order": 40,
            "title": "中心频率",
            "x-unit": "MHz",
            "example": 2120,
            "description": "4G/LTE标准中心频率",
            "x-required-when": "Mode === \"f\"",
            "type": "number"
          },
          "Band": {
            "x-order": 50,
            "title": "频带",
            "example": "b1",
            "description": "4G/LTE标准频带",
            "x-options-from": "output.BandOptions",
            "type": "string"
          },
          "Bandwidth": {
            "x-order": 60,
            "title": "信道带宽",
            "x-unit": "MHz",
            "example": 20,
            "description": "4G/LTE标准信道带宽",
            "x-options-from": "output.BandwidthOptions",
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "DataTransmissionDirection"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "arfcn_calculator_5g_compute",
      "description": "支持5G NR网络中频率与频点之间的相互转换，并附带特定频段的详细信息展示",
      "inputSchema": {
        "type": "object",
        "properties": {
          "Mode": {
            "description": "计算模式，例如 n 表示频点模式，f 表示频率模式",
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "n",
                  "f"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "DataTransmissionDirection": {
            "type": "string",
            "enum": [
              "uplink",
              "downlink"
            ],
            "description": "数据传输方向，可选上行（uplink）、下行（downlink）"
          },
          "NREF": {
            "description": "频点参考值（NREF），例如 `\"504999\"`。用于在频点模式（Mode=`\"n\"`）下确定中心频率。",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "FREF": {
            "description": "频率参考值（FREF），例如 `\"3500.0\"`。用于在频率模式（Mode=`\"f\"`）下直接指定中心频率。",
            "type": [
              "number",
              "null"
            ]
          },
          "Band": {
            "description": "频段标识符，例如 `\"n78\"`、`\"n41\"` 等。用于确定频段的上下行配置、信道栅格（raster）及边界频率。",
            "type": [
              "string",
              "null"
            ]
          },
          "FRaster": {
            "description": "频率栅格（Frequency Raster），单位为 kHz，例如 5、15。用于频点与频率之间的转换计算。",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "SCS": {
            "description": "子载波间隔（Subcarrier Spacing），单位为 kHz，例如 15、30。影响资源块结构和带宽计算。",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "Bandwidth": {
            "description": "信道带宽（Channel Bandwidth），单位为 MHz，例如 5、20、100。用于确定传输带宽配置（Transmission Bandwidth Configuration）。",
            "type": [
              "number",
              "null"
            ]
          },
          "SSBlockSCS": {
            "description": "SSB（Synchronization Signal Block）的子载波间隔，单位为 kHz，例如 15、30。",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "SSBlockPattern": {
            "description": "SSB 波束扫描图案类型，例如 `\"Case A\"`、`\"Case B\"`、`\"Case C\"`（FR1）或 `\"Case D\"`、`\"Case E\"`（FR2），影响 SSB 时域位置和数量。",
            "type": [
              "string",
              "null"
            ]
          },
          "GSCN": {
            "description": "全局同步信道号（Global Synchronization Channel Number），用于粗粒度频率搜索，特别是在非服务小区初始接入时。例如 504990",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "SSREF": {
            "description": "SSB 中心频率对应的参考频率（单位：Hz 或 MHz，依上下文而定），常用于从 GSCN 或 SSB 配置反推绝对频率。",
            "type": [
              "number",
              "null"
            ]
          },
          "N": {
            "description": "用于 SSB 频域位置计算的参数 N，通常与 GSCN 或 raster 相关。例如 6312",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "M": {
            "description": "SSB 频域偏移步长因子，取决于频段和 SSB 子载波间隔。例如 1、3、5",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "DataTransmissionDirection"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
