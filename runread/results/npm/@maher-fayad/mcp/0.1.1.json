    {
      "name": "scan_routes",
      "description": "Statically find the app's routes in the project code (no running app or canvas needed). Detects the framework from package.json and reads Next.js App and Pages Router, Nuxt, SvelteKit, Remix / React Router v7 (flat routes and app/routes.ts), Astro and TanStack Router file routes, plus code-defined React Router (createBrowserRouter arrays, <Route> JSX trees), Vue Router (createRouter({ routes })) and TanStack Router (createRoute) configs, resolving nested and index routes. Returns candidates { route, file, line, framework, kind, name, dynamicParams, sampleHints, samplePath, guards } (route patterns use :id, :id?, :slug+ and :slug*), skipped entries (redirects, not-found catch-alls, parallel / intercepting routes) and notes. sampleHints are real values for dynamic params found in fixtures, seed data and mocks. In a monorepo pass dir (the app folder). Step 1 of the discover_screens recipe.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dir": {
            "description": "Folder to scan, absolute or relative to the project (default: the project folder)",
            "type": "string"
          },
          "includeTests": {
            "description": "Also read test and story files (default false)",
            "type": "boolean"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Scan routes",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
