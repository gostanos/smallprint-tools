    {
      "name": "add_screens",
      "description": "Add many screens in ONE write: one canvas undo step labelled \"Claude: discovered N screens\". Each screen: title, path (a concrete sample the canvas loads, e.g. /product/canele-plate), route (the pattern, e.g. /product/:id), section (id or title; missing sections are created, or declare them in sections with a color), states (first = default; built-in names default, loading, empty, partial, error, success get colored badges). id defaults to the kebab-case title. Leave out position so the canvas lays new screens out by section. mode \"add\" (default) skips screens already on the canvas (same id, route or path); \"merge\" updates them instead (title, path, route, section; new states are appended). The whole batch is validated first (path must be concrete and match route, no duplicates); on any error nothing is written. Marks screens source \"claude\". Returns added, updated, skipped and sectionsCreated.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "screens": {
            "minItems": 1,
            "maxItems": 300,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "description": "kebab-case id; default from title",
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Human title, e.g. \"Product detail\""
                },
                "path": {
                  "type": "string",
                  "format": "starts_with",
                  "pattern": "^\\/.*",
                  "description": "Concrete path the canvas loads, e.g. /product/canele-plate (a real sample, never a pattern)"
                },
                "route": {
                  "description": "Route pattern the path instantiates, e.g. /product/:id; omit for static routes",
                  "type": "string",
                  "format": "starts_with",
                  "pattern": "^\\/.*"
                },
                "section": {
                  "description": "Section id or title; created when it does not exist",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "states": {
                  "description": "States, first = default; default [\"default\"]",
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "position": {
                  "description": "Omit to let the canvas lay the screen out",
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ]
                }
              },
              "required": [
                "title",
                "path"
              ]
            }
          },
          "sections": {
            "description": "Optional section declarations (title, color, parent) for sections the screens use",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "color": {
                  "type": "string",
                  "enum": [
                    "grey",
                    "blue",
                    "green",
                    "amber",
                    "red",
                    "purple"
                  ]
                },
                "parent": {
                  "description": "Parent section id or title",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "title"
              ]
            }
          },
          "mode": {
            "description": "add (default): skip existing screens; merge: update them",
            "type": "string",
            "enum": [
              "add",
              "merge"
            ]
          }
        },
        "required": [
          "screens"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Add screens (batch)",
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
