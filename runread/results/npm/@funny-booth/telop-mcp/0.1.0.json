                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "job",
          "video"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      }
    },
    {
      "name": "check_cards",
      "description": "テロップの cards を決まりで点検し、出だしを声に合わせ直して保存する（制作物/<job>/<動画>/作業/cards.json・check.json）。cards を省くと保存済みの全枚を点検する。range（区切りの範囲）を渡すと start がその範囲の枚だけを置き換え、範囲の枚と、隣の区切りの保存済みの枚との継ぎ目を点検する（区切りごとに並列に呼んでよい）。渡す cards・review_notes の start はすべて範囲の中に置く。返すもの: passed（範囲なしの点検で error 0 のときだけ true。render はこれを要る）、errors・warnings の数、issues（{index: 返した cards の中の番号, start, rule, message, severity: error|warning}）、cards（点検した枚。出だしを合わせ直した後。次に直すときはこれを元にする）、adjustments（合わせ直した枚 {index, from, to}）、maxChars（1行の字数の上限）、reviewNotes（点検が見つけた確認推奨）、writerNotes（保存済みの書き手の確認推奨。範囲つきはその範囲の分。渡した分が残ったかはここで確かめる）、hint。error が0になるまで error の枚だけを直して出し直す。全区切りが揃ったら範囲も cards も省いて呼び、全枚で確かめる。",
