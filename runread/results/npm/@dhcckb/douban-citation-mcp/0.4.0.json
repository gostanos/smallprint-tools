    {
      "name": "generate_citation",
      "description": "根据书籍信息对象和指定的引用风格，生成符合学术规范的参考文献字符串。\n\n支持三种引用风格：\n- gbt7714: GB/T 7714-2015 中国国家标准（信息与文献 参考文献著录规则）\n- apa: APA 7th Edition（美国心理学会格式）\n- mla: MLA 9th Edition（现代语言协会格式）\n\n当必填字段（title、author、publisher、publish_date）缺失时返回错误提示。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "book_info": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "description": "书名"
              },
              "author": {
                "type": "string",
                "description": "作者（多个作者用顿号、逗号或分号分隔）"
              },
              "translator": {
                "type": "string",
                "description": "译者（可选）"
              },
              "publisher": {
                "type": "string",
                "description": "出版社"
              },
              "publish_date": {
                "type": "string",
                "description": "出版日期，支持 \"2020\", \"2020/06\", \"2020-06\" 等格式"
              },
              "isbn": {
                "type": "string",
                "description": "ISBN 号（可选）"
              },
              "edition": {
                "type": "string",
                "description": "版次（可选），例如 '2' 或 '2nd'"
              },
              "series": {
                "type": "string",
                "description": "丛书名（可选）"
              }
            },
            "required": [
              "title",
              "author",
              "publisher",
              "publish_date"
            ],
            "additionalProperties": false,
            "description": "书籍信息对象"
          },
          "citation_style": {
            "type": "string",
            "enum": [
              "gbt7714",
              "apa",
              "mla"
            ],
            "description": "引用格式风格：gbt7714（GB/T 7714）、apa（APA 7th）、mla（MLA 9th）"
          }
        },
        "required": [
          "book_info",
          "citation_style"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "search_and_cite",
      "description": "一站式检索豆瓣图书并自动生成参考文献。\n\n完整流程：\n1. 根据关键词搜索豆瓣图书\n2. 自动检查返回结果的字段完整性（必填字段：书名、作者、出版社、出版日期）\n3. 若必填字段缺失但图书有 ISBN，自动调用 ISBN 接口回查补全\n4. 使用完整信息生成指定格式的参考文献\n\n返回结果包含：最终引用字符串、完整书籍信息、字段补全记录（标记哪些字段来自回查）。\n引用风格默认为 gbt7714（GB/T 7714-2015），可切换为 apa 或 mla。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "检索关键词（书名、作者或 ISBN 号）"
          },
          "citation_style": {
            "type": "string",
            "enum": [
              "gbt7714",
              "apa",
              "mla"
            ],
            "default": "gbt7714",
            "description": "引用格式风格（默认 gbt7714）"
          },
          "search_start": {
            "type": "number",
            "default": 0,
            "description": "搜索结果起始偏移量"
          },
          "search_count": {
            "type": "number",
            "default": 5,
            "description": "返回搜索结果数量（最大 10）"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
