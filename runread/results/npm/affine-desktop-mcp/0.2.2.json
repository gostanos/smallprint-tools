    {
      "name": "affine_create_document",
      "description": "Create a local page or Edgeless canvas with a plain-text note (empty Edgeless content creates a blank canvas). This does NOT turn ASCII/Markdown/Mermaid into shapes: use affine_create_diagram for real diagrams. REQUIRES AFFINE_ENABLE_WRITES=1 and AFFiNE Desktop CLOSED. Backs up SQLite and atomically appends Yjs document/registry/mode updates. Reopen AFFiNE to view. Storage contract: AFFiNE 0.27.4; no live UI sync.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "content": {
            "description": "Plain text stored as a rich-text paragraph, at most 100000 UTF-8 bytes.",
            "type": "string"
          },
          "documentId": {
            "description": "Optional stable ID for safe retries; conflicting existing documents are never overwritten.",
            "type": [
              "string",
              "null"
            ]
          },
          "mode": {
            "$ref": "#/$defs/Mode",
            "description": "page (default) or edgeless. Nonempty content becomes a note, NOT a diagram.\nFor native editable diagram shapes/arrows, use affine_create_diagram instead."
          },
          "title": {
            "description": "Nonblank title, at most 500 characters.",
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          }
        },
        "required": [
          "workspaceId",
          "title",
          "content"
        ],
        "$defs": {
          "Mode": {
            "enum": [
              "page",
              "edgeless"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
