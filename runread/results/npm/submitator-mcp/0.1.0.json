    {
      "name": "preview_launch",
      "description": "Free dry run of launch_project (or of add_directories on a launched project) with the same arguments: how many directories it would submit to, top and median DR, what is missing, what would unlock more, and what it costs. Show the numbers to the user before launching.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "pattern": "^prj_[0-9A-Za-z]{22}$",
            "description": "Project id (prj_...)"
          },
          "directories": {
            "anyOf": [
              {
                "type": "string",
                "const": "auto"
              },
              {
                "type": "object",
                "properties": {
                  "include": {
                    "minItems": 1,
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^dir_[0-9A-Za-z]{22}$",
                      "description": "Directory id (dir_...)"
                    }
                  }
                },
                "required": [
                  "include"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "exclude": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^dir_[0-9A-Za-z]{22}$",
                      "description": "Directory id (dir_...)"
                    }
                  }
                },
                "required": [
                  "exclude"
                ]
              }
            ],
            "description": "\"auto\" (best matches, highest DR first), {include: [ids]} exactly these, or {exclude: [ids]} auto without these"
          },
          "excluded_directories": {
            "description": "Replaces the project's whole exclusion list for this request; [] clears it. To leave some out once, use directories: {exclude}",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^dir_[0-9A-Za-z]{22}$",
              "description": "Directory id (dir_...)"
            }
          },
          "auto_replace": {
            "description": "true: within a day the free allowance fills up to 100 with fitting directories, replacing declined ones too. include turns it off unless you send true",
            "type": "boolean"
          }
        },
        "required": [
          "project_id"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "title": "Preview a launch",
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "find_directories",
      "description": "Searches the directories Submitator submits to, highest Domain Rating first, or reads one by id. Before the agency first buys launches, only the top 20 are shown.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "directory_id": {
            "description": "Read this one directory; other filters are ignored",
            "type": "string",
            "pattern": "^dir_[0-9A-Za-z]{22}$"
          },
          "q": {
            "description": "Part of the name",
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "kind": {
            "description": "article = article platforms, open only through include",
            "type": "string",
            "enum": [
              "directory",
              "article"
            ]
