    {
      "name": "create_render",
      "description": "Render a Templated template into an image (JPG, PNG or WebP), a PDF or an MP4 video, with new text, images and colors in its layers. Use this when the user wants a finished design from one of their templates, such as a social media post, banner, OG image, certificate or invoice. Templated fills the saved template with the exact values given: this is template rendering, not AI image generation. Pass the template ID and 'layers' keyed by the layer names from get_template_layers; names the template doesn't have are rejected before anything is rendered. Multi-page templates render every page, or only the pages listed in 'pages'. Each output counts toward the account's render usage. Returns the render with its file URL (one render per page for multi-page templates).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "template": {
            "type": "string",
            "description": "The template ID to render (from list_templates)"
          },
          "format": {
            "type": "string",
            "enum": [
              "jpg",
              "png",
              "webp",
              "pdf",
              "mp4"
            ],
            "description": "Output format. Default: jpg"
          },
          "layers": {
            "type": "object",
            "description": "Layer values keyed by layer name, e.g. { \"title\": { \"text\": \"Hello\" }, \"photo\": { \"image_url\": \"https://...\" } }. Each value can set text, image_url, color, background, hide and other layer properties. 'animation' (MP4 only) takes 'in' (entrance: type slide|fade|zoom|rotate, direction, duration, writingStyle), 'loop' (type spin|pulse, duration), 'out' (exit: type slide|fade|zoom, direction, duration), 'start' and 'end' (when the layer appears and disappears). All animation times are in milliseconds.",
            "additionalProperties": {
              "type": "object"
            }
          },
          "pages": {
            "type": "array",
            "description": "For multi-page templates: the pages to render, each with its own layer values. Each item has 'page' (a page name from get_template_pages) and 'layers' keyed by layer name, like the top-level 'layers'. Only the listed pages are rendered. Use either 'layers' or 'pages' in one call.",
            "items": {
              "type": "object",
              "properties": {
                "page": {
                  "type": "string",
                  "description": "Page name, as returned by get_template_pages"
                },
                "layers": {
                  "type": "object",
                  "description": "Layer values for this page, keyed by layer name",
                  "additionalProperties": {
                    "type": "object"
                  }
                }
              },
              "required": [
                "page"
              ]
            }
          },
          "transparent": {
            "type": "boolean",
            "description": "Make background transparent (PNG only)"
          },
          "duration": {
            "type": "number",
            "description": "Video duration in milliseconds (MP4 only, max 90000)"
          },
          "fps": {
            "type": "number",
            "description": "Frames per second (MP4 only, 1-60)"
          },
          "flatten": {
            "type": "boolean",
            "description": "Flatten PDF for print-ready documents"
          },
          "cmyk": {
            "type": "boolean",
            "description": "Use CMYK color mode (PDF only)"
          },
          "width": {
            "type": "number",
            "description": "Custom width in pixels (100-5000)"
          },
          "height": {
            "type": "number",
            "description": "Custom height in pixels (100-5000)"
          },
          "scale": {
            "type": "number",
            "description": "Scale factor (0.1-2.0)"
          },
          "name": {
            "type": "string",
            "description": "Custom name for the render"
          },
          "background": {
            "type": "string",
            "description": "Background color in hex format (e.g., #FF0000)"
          }
        },
        "required": [
          "template"
        ]
