    {
      "name": "rpc_status",
      "description": "Probe the public Stellar RPC providers for a network: latency, ledger lag, advertised retention window, and (optionally) how far back getLedgers really reaches. Use it to choose a provider or diagnose slowness.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "network": {
            "default": "testnet",
            "description": "Stellar network.",
            "type": "string",
            "enum": [
              "testnet",
              "mainnet"
            ]
          },
          "samples": {
            "default": 3,
            "description": "getHealth samples per provider.",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "measureReach": {
            "default": false,
            "description": "Also measure how far back getLedgers reaches. Slower.",
            "type": "boolean"
          },
          "rpcUrls": {
            "description": "Custom RPC URLs. Only honoured when the server is started with SOROSCOPE_MCP_ALLOW_CUSTOM_RPC=1.",
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Stellar RPC provider status",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "rpc_route_explain",
      "description": "Say which Stellar RPC provider would serve a call and why each other provider would not (for example, its retention window starts after the requested ledger). Makes no call itself.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "network": {
            "default": "testnet",
            "description": "Stellar network.",
            "type": "string",
            "enum": [
              "testnet",
              "mainnet"
            ]
          },
          "method": {
            "type": "string",
            "pattern": "^[A-Za-z]{3,40}$",
            "description": "RPC method, for example getEvents."
          },
          "startLedger": {
            "description": "Oldest ledger the call needs.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "rpcUrls": {
            "description": "Custom RPC URLs. Only honoured when the server is started with SOROSCOPE_MCP_ALLOW_CUSTOM_RPC=1.",
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
