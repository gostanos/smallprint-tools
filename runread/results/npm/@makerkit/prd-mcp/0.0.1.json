            "type": "string",
            "enum": [
              "introduction",
              "problemStatement",
              "solutionOverview",
              "nonGoals",
              "outOfScope",
              "assumptions",
              "openQuestions",
              "technicalRequirements",
              "technicalContracts",
              "acceptanceCriteria",
              "constraints",
              "rolloutPlan",
              "measurementPlan",
              "risks",
              "dependencies",
              "edgeCases",
              "designGuidance",
              "securityConsiderations"
            ]
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "description": "The PRD revision (metadata.revision) this change is based on. When given and the PRD changed since, the update is rejected: read it again and retry."
          },
          "value": {
            "description": "Object sections (introduction, problemStatement, solutionOverview, technicalRequirements, technicalContracts, acceptanceCriteria, constraints, rolloutPlan, measurementPlan) take an object and only the keys given change. List sections (nonGoals, outOfScope, assumptions, designGuidance, securityConsiderations) take a string array and replace the list. openQuestions takes an array of { question, why, options, recommended, storyIds } (a plain string is accepted too) and replaces the list; keep the ids of existing questions. risks, dependencies and edgeCases take an array of items and replace the list; items without an id get one. An edge case is { case, expectedBehavior, status: \"open\" | \"decided\", storyIds? }; a decided one needs expectedBehavior, and storyIds must name existing stories."
          }
        },
