    {
      "name": "saalplan_anzeigen",
      "description": "Zeigt den Saalplan einer Vorstellung mit echter Belegung und Preisen je Bereich als App. Vorstellung über vorstellung_id oder über film + datum (YYYY-MM-DD) + uhrzeit (HH:MM) angeben. Ohne Anzahl/Bereich aufrufen, um den Plan zu zeigen, und dann nach Ticketanzahl und Bereich (Parkett/Loge) fragen. Mit anzahl und bereich erneut aufrufen: Dann schlägt der Server nebeneinanderliegende Plätze vor und nennt den Preis. Ist die Angabe mehrdeutig, kommt eine Liste mit IDs zurück: nachfragen und mit vorstellung_id erneut aufrufen.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "vorstellung_id": {
            "description": "ID der Vorstellung (falls bekannt).",
            "type": "string",
            "minLength": 1
          },
          "film": {
            "description": "Filmtitel (unscharf), nur ohne vorstellung_id.",
            "type": "string"
          },
          "datum": {
            "description": "Tag der Vorstellung (YYYY-MM-DD), nur ohne vorstellung_id.",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "uhrzeit": {
            "description": "Startzeit HH:MM, nur ohne vorstellung_id.",
            "type": "string",
            "pattern": "^\\d{1,2}:\\d{2}$"
          },
          "anzahl": {
            "description": "Gewünschte Anzahl Tickets (1–10).",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "bereich": {
            "description": "Gewünschter Bereich, z. B. Parkett oder Loge.",
            "type": "string"
          }
        },
