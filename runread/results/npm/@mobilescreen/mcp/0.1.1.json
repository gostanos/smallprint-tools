    {
      "name": "generate_screenshots",
      "description": "Design a full set from raw app screenshots: copy in every project language, a style, backgrounds, device placement. Replaces the project's current set (edits included). Costs 1 credit per screenshot per device. Takes 1-4 minutes; if it is still running when wait_seconds is up, call wait_for_generation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "Project id (from list_projects / create_project)"
          },
          "screenshots": {
            "type": "object",
            "properties": {
              "iphone": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Path to a local PNG or JPEG file"
                }
              },
              "ipad": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Path to a local PNG or JPEG file"
                }
              },
              "android_phone": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Path to a local PNG or JPEG file"
                }
              },
              "android_tablet": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Path to a local PNG or JPEG file"
                }
              }
            },
            "description": "Raw screenshots per device, in store order, e.g. {iphone: ['shots/1.png', ...]}"
          },
          "app_description": {
            "description": "What the app does and for whom. Default: the project's saved description",
            "type": "string"
          },
          "direction": {
            "description": "Art direction for the copy and look: what to stress, words to use or avoid, audience",
            "type": "string"
          },
          "style": {
            "description": "Force a style (see get_reference). Default: chosen from the screenshots",
            "type": "string",
            "enum": [
              "minimal",
              "grotesk",
              "grotesk_serif",
              "editorial",
              "bold",
              "soft",
              "sport"
            ]
          },
          "tone": {
            "description": "Must be allowed by the style",
            "type": "string",
            "enum": [
              "light",
              "dark",
              "brand",
              "pastel",
              "alternate"
            ]
          },
          "accent": {
            "description": "Brand accent color",
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "device_style": {
            "description": "frame = realistic device, minimal = thin black bezel",
            "type": "string",
            "enum": [
              "frame",
              "minimal"
            ]
          },
          "use_sublines": {
            "description": "Add a supporting line under each headline",
            "type": "boolean"
          },
          "wait_seconds": {
            "default": 280,
            "type": "integer",
            "minimum": 0,
            "maximum": 600
          }
        },
        "required": [
          "project_id",
          "screenshots"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
