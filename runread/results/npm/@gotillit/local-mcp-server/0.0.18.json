  "tools": [
    {
      "name": "loadCubeData",
      "description": "Run a Cube Query - Execute analytical queries against the TilliT data cube for reporting and analytics",
      "inputSchema": {
        "type": "object",
        "properties": {
          "body": {
            "type": "object",
            "query": {
              "type": "object",
              "description": "Cube query parameters and configuration",
              "properties": {
                "dimensions": {
                  "type": "array",
                  "description": "Array of dimension field names to include in the cube query. Available dimensions vary by cube type.",
                  "items": {
                    "type": "string"
                  },
                  "examples": [
                    [
                      "Asset.name",
                      "OrderInstance.orderDate"
                    ],
                    [
                      "ActivityInstance.activityName",
                      "ActivityInstance.status"
                    ],
                    [
                      "Material.name",
                      "Production.day"
                    ]
                  ]
                },
                "measures": {
                  "type": "array",
                  "description": "Array of measure field names to calculate. Available measures vary by cube type.",
                  "items": {
                    "type": "string"
                  },
                  "examples": [
                    [
                      "Production.completed",
                      "Production.oee"
                    ],
                    [
                      "ActivityInstance.count",
                      "ActivityInstance.averageCompletionDuration"
                    ],
                    [
                      "EventInstance.count",
                      "EventInstance.duration"
                    ]
                  ]
                },
                "filters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "description": "Filter conditions to apply to the cube query",
                    "properties": {
                      "dateRange": {
                        "type": "array",
                        "description": "Time-based filtering for time dimensions. First element defines the from, seconde element defines the to. Both in ISO 8601"
                      }
                    },
                    "members": {
                      "type": "object",
                      "description": "Member-based filters using dimension field names as keys",
                      "additionalProperties": {
                        "oneOf": [
                          {
                            "type": "array",
                            "description": "Array of values to filter by",
                            "items": {
                              "type": "string"
                            }
                          },
                          {
                            "type": "string",
                            "description": "Single value to filter by"
                          }
                        ]
                      },
                      "examples": [
                        [
                          {
                            "member": "AssetClass.id",
                            "operator": "equals",
                            "values": [
                              "2"
                            ]
                          },
                          {
                            "member": "Production.hourUtc",
                            "operator": "inDateRange",
                            "values": [
                              "2026-02-18T06:00:00.000Z",
                              "2026-02-19T05:59:59.999Z"
                            ]
                          }
                        ]
                      ]
                    }
                  }
                }
              },
              "timeDimensions": {
                "type": "array",
                "description": "Time-based dimensions with granularity and date range",
                "items": {
                  "type": "object",
                  "properties": {
                    "dimension": {
                      "type": "string",
                      "description": "Time dimension field name",
                      "examples": [
                        "OrderInstance.orderDate",
                        "Production.hourUtc",
                        "ActivityInstance.completedAt"
                      ]
                    },
                    "granularity": {
                      "type": "string",
                      "enum": [
                        "day",
                        "week",
                        "month",
                        "quarter",
                        "year",
                        "hour"
                      ],
                      "description": "Time granularity for aggregation"
                    },
                    "dateRange": {
                      "type": "array",
                      "description": "Time-based filtering for time dimensions. First element defines the from, seconde element defines the to. Both in ISO 8601"
                    }
                  },
                  "required": [
                    "dimension"
                  ]
                }
              },
              "order": {
                "type": "object",
                "description": "Sorting configuration for results",
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "asc",
                    "desc"
                  ],
                  "description": "Sort direction for the field"
                },
                "examples": [
                  {
                    "Production.completed": "desc",
                    "Asset.name": "asc"
                  }
                ]
              },
              "limit": {
                "type": "number",
                "description": "Maximum number of records to return",
                "minimum": 1,
                "maximum": 50000,
                "default": 10000
              },
              "offset": {
                "type": "number",
                "description": "Number of records to skip for pagination",
                "minimum": 0,
                "default": 0
              },
              "timezone": {
                "type": "string",
                "description": "Timezone for time-based calculations",
                "examples": [
                  "UTC",
                  "America/New_York",
                  "Europe/London",
                  "Asia/Tokyo"
                ],
                "default": "UTC"
              },
              "renewQuery": {
                "type": "boolean",
                "description": "Force refresh of cached query results",
                "default": false
              }
            },
            "required": []
          }
        },
        "required": [
          "body"
        ]
      }
    },
