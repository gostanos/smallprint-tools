  "tools": [
    {
      "name": "search_markets",
      "description": "Search for prediction markets on Polymarket by keywords. Returns market IDs, questions, volumes and current status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search keywords, e.g. 'bitcoin', 'US election'"
          },
          "limit": {
            "default": 5,
            "description": "Number of events (groups of markets) to return, default 5, max 20",
            "type": "number",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "query",
          "limit"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      }
    },
    {
      "name": "get_market",
      "description": "Get detailed information about a specific Polymarket market including current YES/NO prices and liquidity.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "condition_id": {
            "type": "string",
            "description": "Market condition ID from search_markets"
          }
        },
        "required": [
          "condition_id"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      }
    },
    {
      "name": "get_positions",
      "description": "Get open positions for the configured wallet. Shows market, outcome (YES/NO), size, current price and unrealized PnL.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      }
    },
    {
      "name": "get_history",
      "description": "Get trade history for the configured wallet. Shows past trades with market, side, execution price, amount and status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "default": 20,
            "description": "Number of recent trades, default 20, max 100",
            "type": "number",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "limit"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      }
    },
    {
      "name": "list_markets",
      "description": "List currently active prediction markets on Polymarket sorted by volume. Use this to discover what's trending without a specific search query.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "default": 20,
            "description": "Number of markets to return, default 20, max 100",
            "type": "number",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "description": "Pagination offset, default 0",
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "limit",
          "offset"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      }
    },
    {
      "name": "get_order_book",
      "description": "Get the current order book (bids and asks) for a specific market token. Useful for understanding liquidity and choosing a good limit price before placing an order.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "token_id": {
            "type": "string",
            "description": "Token ID for YES or NO outcome, from get_market → clobTokenIds"
          }
        },
        "required": [
          "token_id"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
