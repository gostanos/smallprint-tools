    {
      "name": "search-emails",
      "description": "Busca emails por texto (KQL) no assunto, corpo e remetente, em todas as pastas. A consulta inteira é tratada como uma frase exata: passe um nome ou termo por vez, sem datas nem operadores. Para limitar o período, use receivedAfter/receivedBefore. Agrupa por thread (conversationId), retorna a mensagem mais recente de cada, e informa a cobertura: quando há mais resultados, diz o receivedBefore para continuar.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Nome ou termo a buscar, tratado como frase exata"
          },
          "top": {
            "type": "number",
            "description": "Número máximo de threads a retornar (padrão: 10)"
          },
          "receivedAfter": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Só emails recebidos a partir desta data, inclusive (AAAA-MM-DD)"
          },
          "receivedBefore": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Só emails recebidos antes desta data, exclusive (AAAA-MM-DD)"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
