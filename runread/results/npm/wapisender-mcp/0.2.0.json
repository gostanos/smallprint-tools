    {
      "name": "update_flow_definition",
      "description": "Replace the full node+edge graph of an existing flow.\n\nNode schema reference:\n\nWapiSender Flow Node Types:\n- trigger: { type: \"trigger\", data: { match: \"any\"|\"contains\"|\"exact\"|\"regex\", keywords: string[] } }\n- send_message: { type: \"send_message\", data: { messageType: \"text\"|\"image\"|\"video\"|\"document\"|\"audio\"|\"voice\"|\"buttons\"|\"list\"|\"location\"|\"poll\"|\"sticker\", text?: string, mediaUrl?: string, audioUrl?: string, stickerUrl?: string } }\n- condition: { type: \"condition\", data: { source: \"last_message\"|\"custom\", variableName?: string, operator: \"equals\"|\"contains\"|\"starts_with\"|\"ends_with\"|\"regex\", value: string } }\n  condition has two output handles: \"true\" and \"false\"\n- delay: { type: \"delay\", data: { amount: number, unit: \"seconds\"|\"minutes\"|\"hours\"|\"days\" } }\n- webhook: { type: \"webhook\", data: { method: \"GET\"|\"POST\"|\"PUT\"|\"PATCH\"|\"DELETE\", url: string, headers?: object, body?: string, responseVariable?: string } }\n- wait_for_reply: { type: \"wait_for_reply\", data: {} }\n- human_handoff: { type: \"human_handoff\", data: { message?: string, resumeAfterMinutes: number } }\n- ai_agent: { type: \"ai_agent\", data: { mode: \"reply\"|\"router\"|\"extract\", credentialId: string, provider: string, model: string, systemPrompt: string, promptTemplate: string, outputVariable: string } }\n- end: { type: \"end\", data: {} }\n\nEdge format: { id: \"e1\", source: \"nodeId\", target: \"nodeId\", sourceHandle?: \"true\"|\"false\" }\nPositions: spread nodes with ~250px vertical spacing starting at { x: 250, y: 100 }\n",
      "inputSchema": {
        "type": "object",
        "properties": {
          "flowId": {
            "type": "string",
            "description": "Flow UUID"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {}
            },
            "description": "Array of flow nodes"
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {}
            },
            "description": "Array of flow edges"
          }
        },
        "required": [
          "flowId",
          "nodes",
          "edges"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
