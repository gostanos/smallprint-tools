  "tools": [
    {
      "name": "capture_browser",
      "description": "Normalize a browser snapshot into a persisted ScreenGraph. Accepts chrome-devtools-mcp take_snapshot output (structuredContent.snapshot, the tree, or uid= text) or a Playwright MCP aria snapshot (page-*.yml / browser_snapshot text, [box=…] gives geometry). Pass either `snapshot` inline or `snapshotPath` (file inside an allowed read root — keeps the tree out of the conversation). Pass bboxEnrichment records from evaluate_script to attach getBoundingClientRect geometry to chrome-devtools uids. Pass screenshotPath + screenshotArtifact metadata to ingest screenshot bytes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "snapshot": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": {}
              },
              {
                "type": "string"
              }
            ]
          },
          "snapshotPath": {
            "type": "string",
            "description": "Path to a snapshot file (Playwright page-*.yml or chrome-devtools text). Must be inside an --allowed-read-root. Mutually exclusive with snapshot."
          },
          "format": {
            "type": "string",
            "enum": [
              "auto",
              "chrome-devtools",
              "playwright-aria"
            ],
            "description": "Text format of snapshot/snapshotPath content. Default auto."
          },
          "bboxEnrichment": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "uid": {
                  "type": "string",
                  "minLength": 1
                },
                "bbox": {
                  "anyOf": [
                    {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "width": {
                          "type": "number"
                        },
                        "height": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "width",
                        "height"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "uid",
                "bbox"
              ],
              "additionalProperties": false
            },
            "description": "Bounding boxes from evaluate_script, keyed by take_snapshot uid."
          },
          "screenshotArtifact": {
            "type": "object",
            "properties": {
              "artifactId": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              },
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "mimeType": {
                "type": "string",
                "enum": [
                  "image/png",
                  "image/jpeg"
                ]
              }
            },
            "required": [
              "artifactId",
              "sha256",
              "width",
              "height",
              "mimeType"
            ],
            "additionalProperties": false
          },
          "screenshotPath": {
            "type": "string",
            "description": "Filesystem path to the screenshot file (e.g. from chrome-devtools take_screenshot --filePath). Requires screenshotArtifact metadata; bytes are ingested into the store so get_artifact resolves."
          },
          "viewport": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "dpr": {
                "type": "number"
              },
              "url": {
                "type": "string"
              },
              "scrollY": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "capture_figma",
      "description": "Capture a Figma node into a persisted ScreenGraph (uses FIGMA_TOKEN env).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fileKey": {
            "type": "string",
            "minLength": 1
          },
          "nodeId": {
            "type": "string",
            "minLength": 1
          },
          "includeImage": {
            "type": "boolean"
          }
        },
        "required": [
          "fileKey",
          "nodeId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ground_instruction",
      "description": "Rank interactables in a ScreenGraph against a natural-language instruction. Returns top-K candidates + a gate verdict. verdict.status: \"accepted\" (safe to act), \"needs_visual_confirm\" (structure ambiguous — look at the screenshot, then call confirm_grounding), \"rejected\" (no viable candidate). This gate is how accuracy approaches 100%: actions only fire when structure is confident or vision confirms it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "screenGraphId": {
            "type": "string",
            "minLength": 1
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "topK": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 50
          },
          "gate": {
            "type": "object",
            "properties": {
              "acceptConfidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minGap": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "rejectConfidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false,
            "description": "Gate thresholds. Defaults: acceptConfidence 0.85, minGap 0.2, rejectConfidence 0.3."
          }
        },
        "required": [
          "screenGraphId",
          "instruction"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "confirm_grounding",
      "description": "Vision second-opinion on an ambiguous grounding verdict. Call ONLY after ground_instruction returned verdict.status \"needs_visual_confirm\". Re-runs the gate with the same instruction and applies your visual verdict. Pass confirmed=true + the interactableId you see is the right target (use the bbox from the candidates); confirmed=false to block. Returns consensus.status: \"act\" (proceed) or \"blocked\".",
      "inputSchema": {
        "type": "object",
        "properties": {
          "screenGraphId": {
            "type": "string",
            "minLength": 1
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "confirmed": {
            "type": "boolean"
          },
          "interactableId": {
            "type": "string",
            "description": "The interactable id vision confirms. Required when confirmed=true."
          },
          "reason": {
            "type": "string"
          },
          "gate": {
            "type": "object",
            "properties": {
              "acceptConfidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minGap": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "rejectConfidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "screenGraphId",
          "instruction",
          "confirmed"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "verify_action",
      "description": "Confirm an action took visible effect via a perceptual pixel diff of before/after screenshots ingested through capture_browser. Pass interactableId to scope the diff to the clicked element bbox (recommended — isolates the change from page-wide noise). Returns changed=true iff the changed-pixel ratio exceeds threshold (default 0.5%). changed=false means no visible state change — the action likely missed or was a no-op.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "screenGraphId": {
            "type": "string",
            "minLength": 1
          },
          "afterScreenGraphId": {
            "type": "string",
            "minLength": 1,
            "description": "Graph captured after the action. Omit only when both artifacts are in the same run."
          },
          "beforeArtifactId": {
            "type": "string",
            "minLength": 1
          },
          "afterArtifactId": {
            "type": "string",
            "minLength": 1
          },
          "interactableId": {
            "type": "string",
            "description": "The clicked interactable. When set, the diff scans only its bbox region."
          },
          "pixelTolerance": {
            "type": "number",
            "minimum": 0,
            "maximum": 255,
            "description": "Per-channel diff (0-255) to count as changed. Default 30."
          },
          "changeThreshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Changed-pixel fraction for changed=true. Default 0.005 (0.5%)."
          }
        },
        "required": [
          "screenGraphId",
          "beforeArtifactId",
          "afterArtifactId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_artifact",
      "description": "Lookup artifact metadata by screenGraphId + artifactId. Returns path + metadata only, never raw bytes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "screenGraphId": {
            "type": "string",
            "minLength": 1
          },
          "artifactId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "screenGraphId",
          "artifactId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "explain_element",
      "description": "Explain why an interactable was extracted: role, name, bbox, sources, confidence, reasoning signals.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "screenGraphId": {
            "type": "string",
            "minLength": 1
          },
          "interactableId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "screenGraphId",
          "interactableId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "compare_graphs",
      "description": "Compare two ScreenGraphs. mode fixture-v0 (default): missingFromActual / extraInActual / bboxDeltas by id. mode screen-v1: real-screen diff — dynamic label parts masked, role is soft, bbox tolerances, page-space y when both viewports carry scrollY — returns {matched, missing, extra, roleChanged, renamed, moved, resized, stateChanged}, every entry with role+name+bbox. Lists are capped at maxListItems (default 20) with counts in `truncatedCounts`.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "expectedScreenGraphId": {
            "type": "string",
            "minLength": 1
          },
          "actualScreenGraphId": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "fixture-v0",
              "screen-v1"
            ]
          },
          "transform": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "enum": [
                  "viewport",
                  "screenshot",
                  "figma"
                ]
              },
              "to": {
                "type": "string",
                "enum": [
                  "viewport",
                  "screenshot",
                  "figma"
                ]
              },
              "factor": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "from",
              "to",
              "factor"
            ],
            "additionalProperties": false
          },
          "labelPatterns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "screen-v1: regex sources masked to # in labels before matching. Default: (N) counters, ISO dates, integers."
          },
          "tolerance": {
            "type": "object",
            "properties": {
              "dx": {
                "type": "number",
                "minimum": 0
              },
              "dy": {
                "type": "number",
                "minimum": 0
              },
              "dw": {
                "type": "number",
                "minimum": 0
              },
              "dh": {
                "type": "number",
                "minimum": 0
              },
              "pctViewport": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false,
            "description": "screen-v1: bbox tolerance, absolute px + fraction of viewport. Default 4/4/2/2 + 1%."
          },
          "scrollCompensation": {
            "type": "boolean",
            "description": "screen-v1: compare y in page space when both graphs have viewport.scrollY. Default true."
          },
          "maxListItems": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 200,
            "description": "screen-v1: cap per finding list in the response. Default 20."
          }
        },
        "required": [
          "expectedScreenGraphId",
          "actualScreenGraphId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "eval_grounding",
      "description": "Fixture-only grounding eval harness. Reports top-K accuracy over a fixtures dir.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fixtureDir": {
            "type": "string",
