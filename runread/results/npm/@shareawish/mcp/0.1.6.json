      "description": "Search the affiliate product catalog with ready affiliate links: Awin feeds and – only if the shop has an Amazon tag in its settings – Amazon. Results are ranked: products whose title contains all words come first, then close matches missing a word (colours and synonyms count as soft criteria). Each hit has productId (Amazon/existing product) or rawProductId (Awin feed row); pass that as product_id or raw_product_id to products_add_existing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "shop_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string",
                "pattern": "^\\d+$"
              }
            ]
          },
          "q": {
            "type": "string",
            "minLength": 1
          },
          "store": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "price_min": {
            "type": "number",
