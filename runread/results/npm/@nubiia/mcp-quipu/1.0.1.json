    {
      "name": "get_tax_summary",
      "description": "Work out the VAT and IRPF position for a period from the invoices and expenses recorded in Quipu. Give it a year and a quarter (or an explicit date range) and it returns output VAT charged on invoices, input VAT paid on expenses, the resulting balance, and withholdings. Use this instead of listing invoices and adding them up by hand: Quipu has no endpoint that returns tax models (130, 303, 111), so the figures must be derived, and doing the arithmetic in code avoids the mistakes that come from adding long lists token by token. Treat the result as an estimate for orientation, not as a filed return.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "year": {
            "type": "number",
            "description": "Year, e.g. 2026"
          },
          "quarter": {
            "type": "number",
            "description": "Quarter: 1, 2, 3 or 4. Ignored when `from` and `to` are provided"
          },
          "from": {
            "type": "string",
            "description": "Start date (YYYY-MM-DD), overrides quarter"
          },
          "to": {
            "type": "string",
            "description": "End date (YYYY-MM-DD), overrides quarter"
          }
        },
