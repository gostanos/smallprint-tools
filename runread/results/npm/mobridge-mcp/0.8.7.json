            "type": "string"
          },
          "pairingCode": {
            "type": "string"
          },
          "waitUserMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 300000,
            "description": "If the phone refuses to enable Accessibility over adb, wait up to this long for the person to turn it on, then continue. Ask the user first; 0 (default) fails fast with ACCESSIBILITY_ENABLE_BLOCKED."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "mobile.screen.observe",
      "description": "Read a compact semantic screen snapshot. Use it when the screen is unknown or after navigation. The status bar and other system chrome are left out by default (appOnly). Example: {\"mode\":\"fast\"}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "actionableOnly": {
            "type": "boolean"
          },
          "appOnly": {
            "type": "boolean",
            "description": "Default true here: leave out the status bar (clock, battery, signal) and other unfocused system chrome. Pass false to see them."
          },
          "mode": {
            "enum": [
              "fast",
              "understand"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "mobile.screen.act",
      "description": "Execute exactly one semantic tap, type, scroll, gesture or key action; use target or a semantic query. Pick the node with `query` (preferred, resolved fresh) or a `target` NodeRef. verify.policy is optional: omit it or use AUTO to let MoBridge choose, else one of the listed values. observe again after an action that changes the screen. Examples: {\"action\":\"CLICK\",\"query\":{\"text\":\"Login\"},\"verify\":{\"policy\":\"WINDOW_CHANGED\"},\"operationId\":\"op-login-0001\"} {\"action\":\"KEY\",\"key\":\"BACK\",\"operationId\":\"op-back-0001\"}",
