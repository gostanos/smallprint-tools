    {
      "name": "mobile.device.connect",
      "description": "Connect one device through the shared MoBridge daemon and return ready/blockers/warnings health preflight. Call once per session; the result's `usage` lists the onboarding steps (read the guide, discover the CLI, safety rules) to follow before acting.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "platform": {
            "enum": [
              "android"
            ]
          },
