    {
      "name": "mobile.run",
      "description": "Run a JSONL workflow plan with stable workflowId/stepId identity, daemon-side dataflow, verification and resume semantics. Reuse workflowId when resuming or switching between MCP and CLI. The final screen state is omitted unless returnState=true. Example: {\"workflowId\":\"wf-login-0001\",\"plan\":\"{\\\"id\\\":\\\"s1\\\",\\\"tap\\\":{\\\"text\\\":\\\"Login\\\"}}\\n{\\\"id\\\":\\\"s2\\\",\\\"key\\\":\\\"BACK\\\"}\"}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "plan": {
            "type": "string"
          },
          "workflowId": {
            "type": "string",
            "minLength": 8
          },
          "waitUntil": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "condition"
            ],
            "properties": {
              "condition": {},
              "timeoutMs": {
                "type": "integer",
                "minimum": 1
              },
              "stableForMs": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "returnState": {
            "type": "boolean",
            "default": false
          },
          "allowFallback": {
            "type": "string"
          },
          "resumeToken": {
            "type": "string"
          },
          "resolvedNodeId": {
            "type": "string"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "plan",
          "workflowId"
        ],
        "additionalProperties": false
      }
    }
