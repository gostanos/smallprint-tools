          "verified": {
            "type": "boolean",
            "description": "Filter for verified users."
          },
          "blue_verified": {
            "type": "boolean",
            "description": "Filter for blue-checkmark verified users."
          },
          "is_quote": {
            "type": "boolean",
            "description": "Include only posts that are quotes."
          },
          "is_video": {
            "type": "boolean",
            "description": "Include only posts with video."
          },
          "is_image": {
            "type": "boolean",
            "description": "Include only posts with images."
          },
