    {
      "name": "ai-search",
      "description": "AI search and analysis on web using Desearch AI",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Question, example: 'What is the latest news on AI?'"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "web",
                "twitter",
                "arxiv",
                "wikipedia",
                "hackernews",
                "reddit"
              ]
            },
            "default": [
              "web",
              "twitter"
            ],
            "description": "Source ids sent to POST /desearch/ai/search. Short ids: 'web', 'twitter', 'arxiv', 'wikipedia', 'hackernews', 'reddit'. Legacy labels such as 'Web Search', 'ArXiv Search', 'Wikipedia Search', 'Hacker News Search', and 'Reddit Search' are rewritten to those ids. Example: ['web', 'twitter']."
          },
          "date_filter": {
            "type": "string",
            "enum": [
              "PAST_24_HOURS",
              "PAST_2_DAYS",
              "PAST_WEEK",
              "PAST_2_WEEKS",
              "PAST_MONTH",
              "PAST_2_MONTHS",
              "PAST_YEAR",
              "PAST_2_YEARS"
            ],
            "description": "Deprecated relative window; prefer start_date/end_date. Example: 'PAST_WEEK'"
          },
          "start_date": {
            "type": "string",
            "description": "Start of the date range in UTC (YYYY-MM-DDTHH:MM:SSZ). Use with end_date."
          },
          "end_date": {
            "type": "string",
            "description": "End of the date range in UTC (YYYY-MM-DDTHH:MM:SSZ). Use with start_date."
          },
          "result_type": {
            "type": "string",
            "enum": [
              "ONLY_LINKS",
              "LINKS_WITH_FINAL_SUMMARY"
            ],
            "description": "ONLY_LINKS returns links only; LINKS_WITH_FINAL_SUMMARY adds an AI summary. Link arrays are kept under whichever key the API uses, along with billing fields. ONLY_LINKS still depends on the API to include those links."
          },
          "include_domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Restrict Web Search results to these domains, example: ['bbc.com', 'reuters.com']"
          },
          "exclude_domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Drop Web Search results from these domains, example: ['pinterest.com']"
          },
          "model": {
            "type": "string",
            "enum": [
              "NOVA",
              "ORBIT"
            ],
            "default": "NOVA",
            "description": "Model to use for the search: NOVA (default) or ORBIT."
          }
        },
        "required": [
          "prompt"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "AI Search",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": true
      }
    },
