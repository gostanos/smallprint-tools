          "current": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cell": {
                  "type": "string",
                  "pattern": "^(desktop|phone|tablet)-(light|dark)$",
                  "description": "<viewport>-<theme>, e.g. desktop-light or phone-light."
                },
                "path": {
                  "description": "A PNG/WebP/JPEG file on this machine. It is uploaded for you (≤ 10 MiB).",
                  "type": "string"
                },
                "upload_id": {
                  "description": "From request_upload, after you PUT the bytes.",
                  "type": "string"
                },
                "base64_png": {
                  "description": "Inline image; prefer path or request_upload for anything large.",
                  "type": "string",
                  "maxLength": 14000000
                },
                "source_ref": {
                  "type": "string"
                },
                "build_sha": {
                  "type": "string"
                }
              },
              "required": [
                "cell"
