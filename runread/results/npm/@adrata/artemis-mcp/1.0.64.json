    {
      "name": "attach_design",
      "description": "Attach a full HTML design (a clickable prototype) to a decision, so the reviewer opens it full window in Artemis and can pin comments on it. path is a single .html file or a directory bundle (entry + CSS/JS/fonts/images, relative links). Limits: 10 MiB per file, 50 MiB and 200 files per design; allowed types html, css, js, json, svg, png, jpeg, webp, gif, avif, ico, woff, woff2, ttf, otf, mp4, webm, txt. The design runs sandboxed: it cannot call Artemis, and localStorage is in-memory. Returns the design and its immersive link; comments pinned on it reach you through get_change_requests with design and pin.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "A .html file or a directory on this machine."
