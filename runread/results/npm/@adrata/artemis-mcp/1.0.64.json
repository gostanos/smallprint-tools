            "type": "string",
            "minLength": 1,
            "maxLength": 140,
            "description": "What the reviewer sees, e.g. \"Industry app, feed-first\"."
          },
          "entry": {
            "description": "The entry HTML inside a directory bundle; defaults to the only .html file, else index.html.",
            "type": "string"
          },
          "version_id": {
            "description": "The version this design belongs to; defaults to the decision's current version.",
            "type": "string"
          }
        },
        "required": [
