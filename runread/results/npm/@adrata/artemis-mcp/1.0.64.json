                "type": "string"
              },
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            ]
          },
          "pr_body": {
            "description": "The PR description; only its Card:/Cards: trailer is read, to link Starfield cards.",
            "type": "string",
            "maxLength": 65536
          },
          "card_ids": {
            "description": "Starfield card ids to link explicitly (wins over the PR trailer and the branch prefix).",
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "title": {
            "type": "string",
