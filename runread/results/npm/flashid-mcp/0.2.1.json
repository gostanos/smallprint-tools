    {
      "name": "create_profile",
      "description": "Create a browser profile. Only `system` is required — everything else has sensible defaults and omitted fingerprint fields are auto-generated as a coherent random fingerprint. Bind a proxy via `proxy` (static = saved proxy from list_proxies; rotating = dynamic residential). Fine-grained fingerprint control goes in `advanced`. Returns the new profile_uuid.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "system": {
            "type": "object",
            "properties": {
              "os": {
                "type": "string",
                "enum": [
                  "Windows",
                  "Mac OS X"
                ]
              },
              "version": {
                "type": "string",
                "enum": [
                  "11",
                  "10",
                  "26",
                  "15",
                  "14",
                  "13"
                ],
                "description": "OS version. Windows: 11 | 10 — Mac OS X: 26 | 15 | 14 | 13"
              }
            },
            "required": [
              "os",
              "version"
            ],
            "additionalProperties": false,
            "description": "Operating system the browser fingerprint emulates"
          },
          "profile_name": {
            "type": "string",
            "description": "Display name"
          },
          "note": {
            "type": "string",
            "description": "Free-text note"
          },
          "folder_uuid": {
            "type": "string",
            "description": "Folder to place the profile in (\"0\" = root)"
          },
          "tag_uuids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Workspace tag UUIDs to associate with the profile"
          },
          "cookie": {
            "type": "string",
            "description": "Cookies as a plaintext JSON string"
          },
          "launch_arguments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Custom Chromium launch arguments, one argument per item"
          },
          "proxy": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "none",
                  "static",
                  "rotating"
                ],
                "description": "none = no proxy; static = bind a saved proxy; rotating = dynamic residential proxy"
              },
              "proxy_uuid": {
                "type": "string",
                "description": "Required when mode=static — uuid of a saved proxy (from list_proxies)"
              },
              "type": {
                "type": "string",
                "enum": [
                  "residential"
                ],
                "description": "mode=rotating only. Only residential is supported"
              },
              "region": {
                "type": "string",
                "description": "mode=rotating — country/region code from list_proxy_regions"
              },
              "state": {
                "type": "string",
                "description": "mode=rotating — optional sub-region"
              },
              "city": {
                "type": "string",
                "description": "mode=rotating — optional city"
              },
              "ipchecker": {
                "type": "string",
                "enum": [
                  "ip2location",
                  "ipapi"
                ],
                "description": "Optional IP lookup service"
              }
            },
            "required": [
              "mode"
            ],
            "additionalProperties": false,
            "description": "Proxy binding. Omit entirely for no proxy"
          },
          "advanced": {
            "type": "object",
            "additionalProperties": {},
            "description": "Advanced fingerprint overrides, merged into the request body at top level. Same shape as the FlashID Local API create-profile body: each field is {\"mode\": ..., <values>} (fields: user_agent, webrtc, timezone, geo_location, language, webgl_info, webgl, canvas, audio_context, client_rects, speech_voices, screen, fonts, cpu, ram, media_devices, device_name, mac_address, do_not_track, webgpu). Omitted random/noise fields are auto-generated, so this is rarely needed. Full reference: https://docs.flashid.app"
          }
        },
        "required": [
          "system"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
