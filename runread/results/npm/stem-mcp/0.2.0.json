                "blocks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "md": {
                        "type": "string"
                      },
                      "fragment": {
                        "type": "boolean"
                      },
                      "solution": {
                        "type": "boolean"
                      }
                    },
                    "required": [
