      "name": "generate_credential",
      "description": "Generate a representative OB3 AchievementCredential JSON-LD document by walking the type graph. Optionally returns a Mermaid diagram of the traversal path and coverage metrics. Reproducible output requires pinning `seed`, `mode`, and `maxDepth` together — a `seed` alone reproduces output only for the same `mode` and `maxDepth`. `targetClasses` narrows generation to specified OB3 classes (plus schema-required closure). `attachProof` attaches a real Ed25519 DataIntegrityProof using a fresh ephemeral key, so the determinism contract applies to the unsigned document.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "maxDepth": {
            "description": "Traversal depth (0-10, default 3)",
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "mode": {
            "description": "Generation mode: minimal (required fields only) or full (all fields). Default: minimal",
            "type": "string",
            "enum": [
              "minimal",
              "full"
            ]
          },
          "seed": {
            "description": "Optional PRNG seed for deterministic output",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "includeMermaid": {
            "description": "Include Mermaid diagram of the traversal path (default false)",
            "type": "boolean"
          },
          "contentMode": {
            "description": "Content mode: 'uuid' (default; fast spec-coverage with UUID values) or 'realistic' (faker-driven values for rendering-app testing)",
            "type": "string",
            "enum": [
              "uuid",
              "realistic"
            ]
          },
          "targetClasses": {
            "description": "Optional subset of OB3 class names to target; only these classes (plus schema-required closure) will be populated",
