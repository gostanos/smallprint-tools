    {
      "name": "get_historical_weather",
      "description": "Daily historical observations from a weather station (Frost archive, some stations go back over 100 years). Find station ids with find_weather_stations.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "station_id": {
            "type": "string",
