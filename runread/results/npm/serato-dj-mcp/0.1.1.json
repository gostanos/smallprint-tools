    {
      "name": "search_tracks",
      "description": "Search the Serato library. Free text `q` matches every whitespace-separated token against title, artist, album, genre and comments. Tonality is Camelot (`8A`); tracks whose key Serato itself could not parse are included, and `key_source` says where each key came from. `bpm.around` cannot be combined with `bpm.min`/`bpm.max`. `key.compatible_with` expands to the four mixable cells of the wheel. `rating` is a 0 to 1 scale, not 0 to 5 stars. Sort is one of bpm, added, artist, title, rating, relevance with an optional :asc/:desc; relevance needs a q. Default fields: id, artist, title, bpm, key, key_source, genre, rating, length. Paths are redacted to ~.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 512
          },
          "bpm": {
            "type": "object",
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "around": {
                "type": "number"
              },
              "tolerance_pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              }
            }
