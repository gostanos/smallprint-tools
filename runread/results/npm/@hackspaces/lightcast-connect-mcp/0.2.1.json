    {
      "name": "lightcast_postings_totals",
      "description": "How many job postings exist for a filter, over a month range. The live-demand primitive: counts real US job ads by occupation, program (CIP), skill, employer, or place. Returns unique postings plus median posting duration (how long ads stay up — a tightness signal).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "description": "First month, YYYY-MM (e.g. '2025-08')."
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "description": "Last month, YYYY-MM (e.g. '2026-07')."
          },
          "soc": {
            "description": "SOC codes, e.g. ['15-1212']. An O*NET-style '.00' suffix is accepted.",
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{2}-\\d{4}(\\.\\d{2})?$"
            }
          },
          "cip": {
            "description": "6-digit CIP codes — filters postings by the field of study they map to.",
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{2}\\.?\\d{4}$"
            }
          },
          "skills": {
            "description": "Skill names, e.g. ['Python (Programming Language)'].",
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state": {
            "description": "State FIPS codes, e.g. ['4'] for Arizona. Zero-padded ('04') is accepted too.",
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "msa": {
            "description": "Metro (MSA) codes.",
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "description": "Job title names.",
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "company": {
            "description": "Employer names.",
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remote_only": {
            "description": "Limit to postings advertised as remote.",
            "type": "boolean"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "additionalProperties": false
      }
    },
