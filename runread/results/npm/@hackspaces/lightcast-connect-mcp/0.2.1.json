    {
      "name": "lightcast_market_salary",
      "description": "Modeled salary percentiles (10th-90th + mean) for an occupation or a skill, optionally narrowed by state/metro/county, industry (NAICS), required experience, education, remote type, or up to 3 skills. Use dimension 'skill' with a Lightcast skill id to price a skill; use an occupation dimension with a `filter.skill` list to see the premium a skill adds to a role. Modeled from Lightcast US job postings (advertised pay), not BLS OES survey wages; the two differ and should not be mixed in one figure.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dimension": {
            "default": "soc",
            "description": "Taxonomy of `id`: soc (BLS SOC, e.g. '15-1252'), onet ('15-1252.00'), lotocc / lotspecocc (Lightcast occupation ids), or skill (Lightcast skill id, e.g. 'KS1200364C9C1LK3V5Q1').",
            "type": "string",
            "enum": [
              "soc",
              "onet",
              "lotocc",
              "lotspecocc",
              "skill"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Id in that dimension (see dimension description)."
          },
          "filter": {
            "description": "Optional narrowing. Omit for the national, all-industry, all-experience figure.",
            "type": "object",
            "properties": {
              "state": {
                "description": "State FIPS, e.g. '4' for Arizona.",
                "type": "string"
              },
              "msa": {
                "description": "Lightcast MSA code, e.g. '38060' for Phoenix.",
                "type": "string"
              },
              "county": {
                "description": "County FIPS, e.g. '4013' for Maricopa.",
                "type": "string"
              },
              "naics2": {
                "description": "2-digit NAICS industry.",
                "type": "string"
              },
              "naics3": {
                "type": "string"
              },
              "naics4": {
                "type": "string"
              },
              "naics5": {
                "type": "string"
              },
              "naics6": {
                "type": "string"
              },
              "skill": {
                "description": "Up to 3 Lightcast skill ids to condition the salary on. Not allowed when dimension is 'skill'.",
                "minItems": 1,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "yearsExperience": {
                "description": "Bound on the minimum years of experience postings ask for, e.g. {gte: 0, lte: 3} for entry level.",
                "type": "object",
                "properties": {
                  "gte": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "lte": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false
              },
              "minEduLevels": {
                "description": "Normalized education level code.",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "remoteType": {
                "description": "Remote type id.",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "soc": {
                "description": "Only when dimension is 'skill': restrict to a SOC code.",
                "type": "string"
              },
              "onet": {
                "description": "Only when dimension is 'skill': restrict to an O*NET code.",
                "type": "string"
              },
              "lotOcc": {
                "description": "Only when dimension is 'skill': restrict to a LOT occupation.",
                "type": "string"
              },
              "lotSpecOcc": {
                "description": "Only when dimension is 'skill': restrict to a LOT specialized occupation.",
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "dimension",
          "id"
        ],
        "additionalProperties": false
