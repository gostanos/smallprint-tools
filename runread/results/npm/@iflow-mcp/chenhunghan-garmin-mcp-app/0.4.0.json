    {
      "name": "create-workout",
      "description": "Create a new workout on Garmin Connect.\n\nWorkout structure:\n- sportType: { sportTypeId: 1, sportTypeKey: 'running' } for running\n- workoutSegments: array of segments, each with segmentOrder and workoutSteps\n- Each step uses type \"ExecutableStepDTO\" for regular steps, \"RepeatGroupDTO\" for repeat groups\n- Common step structure: { stepOrder, stepType, endCondition, endConditionValue, targetType, targetValueLow, targetValueHigh }\n\nStep types: warmup, cooldown, interval, rest, recovery, repeat\nEnd conditions: time (seconds), distance (meters), lap.button (manual lap)\nTarget types: heart.rate.zone (1-5), pace.zone, speed.zone, no.target\n\nExample - 5x1000m intervals:\n- Warmup: 15min easy (endCondition: time, endConditionValue: 900)\n- Repeat group (numberOfIterations: 5):\n  - Interval: 1000m (endCondition: distance, endConditionValue: 1000)\n  - Recovery: 90s jog (endCondition: time, endConditionValue: 90)\n- Cooldown: 10min easy (endCondition: time, endConditionValue: 600)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workout": {
            "type": "object",
            "properties": {
              "workoutName": {
                "type": "string",
                "description": "Name for the workout"
              },
              "sportType": {
                "type": "object",
                "properties": {
                  "sportTypeId": {
                    "type": "number",
                    "description": "Sport type ID (1=running, 2=cycling, 3=swimming)"
                  },
                  "sportTypeKey": {
                    "type": "string",
                    "description": "Sport type key (e.g. 'running')"
                  }
                },
                "required": [
                  "sportTypeId",
                  "sportTypeKey"
                ],
                "description": "Sport type"
              },
              "workoutSegments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "description": "Array of workout segments containing steps (warmup, intervals, cooldown). Each segment has sportType and workoutSteps array."
              },
              "description": {
                "description": "Optional workout description",
                "type": "string"
              }
            },
            "required": [
              "workoutName",
              "sportType",
              "workoutSegments"
            ],
            "description": "Workout object following Garmin workout JSON structure"
          }
        },
        "required": [
