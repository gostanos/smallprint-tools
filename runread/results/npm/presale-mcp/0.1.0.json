    {
      "name": "search_by_nearby_keyword",
      "description": "Presale Remote MCP(분양가 분석 MCP) searches nearby places by Kakao Local keyword around coordinates. Supports apartment/officetel/library presets, category filters, dedupe, distance limit, offset pagination, and grid mode for dense or wide-radius searches that need better recall. If has_more is true, continue with next_offset.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "center_lat": {
            "description": "검색 중심 위도",
            "type": "number"
          },
          "center_lng": {
            "description": "검색 중심 경도",
            "type": "number"
          },
          "radius_m": {
            "description": "검색 반경 미터. 최대 20000",
            "default": 2000,
            "type": "integer",
            "minimum": 0,
            "maximum": 20000
          },
          "query": {
            "description": "직접 검색 키워드. preset 미사용 시 필수",
            "type": "string"
          },
          "preset": {
            "description": "미리 정의된 검색 preset",
            "type": "string",
            "enum": [
              "apartment",
              "officetel",
              "library"
            ]
          },
          "category_filter": {
            "description": "카카오 category_name 기반 포함/제외 필터",
            "type": "object",
            "properties": {
              "include_contains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exclude_contains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "deduplicate_by": {
            "description": "중복 제거 기준",
            "type": "string",
            "enum": [
              "name",
              "address"
