    {
      "name": "get_complex_info",
      "description": "Presale Remote MCP(분양가 분석 MCP) retrieves K-apt apartment complex metadata regardless of unit count. Provide kapt_code, bjd_code plus complex_name, or complex_query for automatic location and K-apt code resolution. Ambiguous or unregistered complexes return candidates or NOT_FOUND without guessing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kapt_code": {
            "description": "단지코드. 알면 이것만으로 바로 조회(해소 단계 생략).",
            "type": "string"
          },
          "bjd_code": {
            "description": "법정동코드 10자리. kapt_code가 없을 때 complex_name과 함께 단지코드 해소에 사용. get_geocode의 region_code에서 얻을 수 있음.",
            "type": "string"
          },
          "complex_name": {
            "description": "단지명. kapt_code가 없을 때 bjd_code와 함께 매칭.",
            "type": "string"
          },
          "complex_query": {
            "description": "단지명 또는 주소 자유형 입력. 이것만 주면 내부에서 카카오 검색→주소→법정동코드를 자동 해소한 뒤 K-apt 단지를 매칭합니다(가장 간편한 입구). kapt_code/bjd_code가 있으면 그쪽이 우선.",
            "type": "string"
          },
          "detail": {
            "default": false,
            "description": "true면 상세정보(주차·승강기·CCTV·교통·시설 등)까지 조회·병합하고 parking_per_unit을 파생.",
            "type": "boolean"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Get Complex Info",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_complex_trades",
      "description": "Presale Remote MCP(분양가 분석 MCP) retrieves MOLIT apartment sale, resale, rent, or all three trade types by region_code and year_month, with optional complex_query or legal-dong/jibun filters. For resale, resale_ownership can include occupancy-right rows separately from presale rights. It returns NOT_FOUND or PARTIAL when trades cannot be confirmed and does not estimate prices.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "region_code": {
            "description": "시군구코드 5자리(LAWD_CD). get_region_code의 sigungu_code 사용. 예: 11110. complex_query를 주면 생략 가능.",
            "type": "string",
            "pattern": "^\\d{5}$"
          },
          "year_month": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "description": "계약년월 YYYYMM. 예: 202407"
          },
          "trade_type": {
            "default": "sale",
            "description": "거래유형: sale=매매, resale=분양권전매, rent=전월세, all=세 유형 병렬 조회",
            "type": "string",
            "enum": [
              "sale",
              "resale",
              "rent",
              "all"
            ]
          },
          "resale_ownership": {
            "default": "presale_only",
            "description": "분양권전매(resale) 결과의 소유권 구분. presale_only=분양권/공란만(기본), all=입주권 포함. 입주권은 재건축 조합원 물량으로 일반분양가와 성격이 다릅니다.",
            "type": "string",
            "enum": [
              "presale_only",
              "all"
            ]
          },
          "complex_query": {
            "description": "단지명 또는 주소 자유형 입력. 주면 카카오 검색→주소→시군구코드+법정동+지번을 자동 해소해 해당 단지 거래만 필터링합니다(region_code/complex_filter 생략 가능).",
            "type": "string"
          },
          "complex_filter": {
            "description": "특정 단지 필터. 생략하면 시군구 전체 거래 반환",
            "type": "object",
            "properties": {
              "umd": {
                "type": "string",
                "minLength": 1,
                "description": "법정동명. 예: 숭인동"
              },
              "jibun": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ],
                "description": "지번 1개 또는 여러 개. 예: 202-3"
              },
              "jibun_match": {
                "default": "exact",
                "description": "exact=전체 지번 일치, bonbun=본번만 일치",
                "type": "string",
                "enum": [
                  "exact",
                  "bonbun"
                ]
              },
              "apt_name": {
                "description": "선택 보조 필터용 단지명",
                "type": "string"
              }
            },
            "required": [
              "umd",
              "jibun"
            ]
          },
          "num_of_rows": {
            "default": 1000,
            "description": "페이지당 조회 건수. 기본 1000",
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "limit": {
            "default": 30,
            "description": "응답에 반환할 거래 행 수. 요약은 전체 필터 결과 기준으로 계산하고 items만 제한합니다. 기본 30, 최대 100",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "year_month"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Get Complex Trades",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
