    {
      "name": "inventory_lookup",
      "description": "Use when you need the CS2 items in a public Steam inventory, given a SteamID64, a vanity name or a profile URL. Needs INSPEKT_SECRET. Returns the item count and up to limit items. Each lookup counts against the inventory quota, with 5 uncached lookups a minute per address. Reuse the answer. Example: {\"steamid\":\"76561197960287930\",\"limit\":10}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "steamid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\s\"'`]+$",
            "description": "A SteamID64, a vanity profile name or a full profile URL."
          },
          "limit": {
            "default": 25,
            "description": "Items to return, 1 to 50.",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "steamid"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "catalog_search",
      "description": "Use to find the catalog id of a skin before render_still or embed_snippet, or to read the float range a finish comes in. Matches finish name and weapon, ignoring case and punctuation (\"ak redline\", \"AK-47\", \"m4a4 howl\"). Each row has id (pass it as id), name, weapon, itemIndex, paintKitIndex and the float range wearRemapMin to wearRemapMax. No key needed. Example: {\"query\":\"redline\",\"weapon\":\"ak47\"}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "description": "Words from the name, such as \"redline\" or \"ak redline\".",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "weapon": {
            "description": "Weapon, such as \"AK-47\", \"ak47\", \"karambit\" or \"m4a4\".",
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "limit": {
            "default": 10,
            "description": "Most rows to return, 1 to 50.",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "docs",
      "description": "Use when you need the exact rules: parameters and bounds, which key goes where, the origin allowlist, refusal codes, limits, plans or a worked example. Returns one topic of the inspekt agent pack. section narrows it to one heading, such as \"charms\" or \"secret keys\". Read errors after a refusal code, and keys before advising which key goes where. Example: {\"topic\":\"render_api\",\"section\":\"charms\"}",
      "inputSchema": {
        "type": "object",
