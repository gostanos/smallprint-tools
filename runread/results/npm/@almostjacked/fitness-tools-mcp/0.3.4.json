        "type": "object",
        "properties": {
          "sex": {
            "type": "string",
            "enum": [
              "male",
              "female"
            ]
          },
          "age": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 120
          },
          "height": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "type": "string",
                "enum": [
                  "cm",
                  "in",
                  "mm"
                ],
                "default": "cm"
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          },
          "weight": {
            "type": "object",
            "properties": {
              "value": {
                "$ref": "#/properties/height/properties/value"
              },
              "unit": {
                "type": "string",
                "enum": [
                  "kg",
                  "lb"
                ],
                "default": "kg"
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          },
          "activity": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "sedentary",
                  "light",
                  "moderate",
                  "active",
                  "very_active"
                ]
              },
              {
                "type": "number"
              }
            ]
          },
          "body_fat": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 2,
                "maximum": 70
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "lean_mass": {
            "anyOf": [
              {
                "$ref": "#/properties/weight"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "methods": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "string"
              }
            ],
            "default": "all"
          }
        },
        "required": [
          "sex",
          "age",
          "height",
          "weight",
          "activity"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Total Daily Energy Expenditure",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "adaptive-tdee",
      "description": "Measure actual TDEE from a logged history of daily weight and/or calorie intake. Default method (kalman) is a joint Kalman filter over true weight and TDEE — handles missing days, gates outliers, and reports uncertainty (CI95) alongside denoised true weight; regression/endpoints are simple window-based estimates kept for comparison. Use instead of formula TDEE once real logged data exists. Each entry needs at least one of weight/kcal (not necessarily both). Entry dates must span 10 years or less (earliest to latest). Note: all methods need at least one weigh-in (kalman) or two (regression/endpoints) — a history with zero weight entries throws under the kalman default; pass methods:'all' to get a graceful empty/skipped result instead.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "weight": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "unit": {
                      "type": "string",
                      "enum": [
                        "kg",
                        "lb"
                      ],
                      "default": "kg"
                    }
                  },
                  "required": [
                    "value"
                  ],
                  "additionalProperties": false
                },
                "kcal": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 20000
                }
              },
              "required": [
                "date"
              ],
              "additionalProperties": false
            },
            "minItems": 10,
            "maxItems": 400
          },
          "window_days": {
            "type": "integer",
            "minimum": 3,
            "maximum": 14,
            "default": 7
          },
          "prior_tdee_kcal": {
            "type": "number",
            "minimum": 500,
            "maximum": 10000,
            "description": "Optional starting TDEE estimate, e.g. from the tdee tool; speeds early convergence."
          },
          "methods": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "string"
              }
            ],
            "default": "kalman"
          }
        },
        "required": [
          "entries"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Adaptive TDEE",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
