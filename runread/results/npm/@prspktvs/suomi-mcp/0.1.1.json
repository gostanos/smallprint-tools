            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Exact provider schema value IDs or exact labels for one already selected dimension; each lookup uses exact membership."
          },
