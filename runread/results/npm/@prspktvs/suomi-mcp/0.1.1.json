        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "search",
              "inspect",
              "page",
              "match"
            ]
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "For search: one to three publisher-metadata terms chosen from the plan. Candidate source cards, when present, are generated discovery hints with explicit provenance—not official claims, evidence, or source authorization. Verify every choice against the live inspected schema. Omit on other actions."
          },
          "provider_id": {
            "type": "string",
            "enum": [
              "statfin",
              "traficom",
              "vero",
              "vero-web",
              "visitfinland",
              "kototietokanta",
              "luke",
              "etk",
              "helsinki"
            ],
            "description": "Choose the publisher from the plan before searching; omit only if the plan genuinely does not identify a suitable publisher. Never send an empty string."
          },
          "resource_id": {
            "type": "string",
            "minLength": 1,
            "description": "For inspect only: a known publisher resource path, paired with provider_id. This lets a caller inspect a source whose catalog entry is not currently discoverable."
