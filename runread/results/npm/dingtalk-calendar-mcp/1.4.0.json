            "properties": {
              "date": {
                "type": "string",
                "description": "日期，格式：yyyy-MM-dd（全天日程使用）"
              },
              "dateTime": {
                "type": "string",
                "description": "日期时间，ISO-8601格式（非全天日程使用）"
              },
              "timeZone": {
                "type": "string",
                "description": "时区，如Asia/Shanghai"
              }
            }
          },
