          },
          "reminders": {
            "type": "array",
            "description": "日程提醒设置，数组中每个对象包含method和minutes字段。如不传默认开始前15分钟提醒，传空数组表示不设提醒。method只支持\"dingtalk\"（钉钉内提醒），minutes为Integer类型表示提前N分钟提醒。示例：[{\"method\":\"dingtalk\",\"minutes\":15}]"
          },
          "recurrence": {
            "type": "object",
            "description": "日程循环规则对象",
            "properties": {
              "pattern": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "循环类型：daily, weekly, absoluteMonthly, relativeMonthly, absoluteYearly"
                  },
                  "interval": {
                    "type": "number",
                    "description": "循环间隔"
                  },
                  "daysOfWeek": {
                    "type": "string",
                    "description": "星期几，多个值逗号分隔"
                  },
                  "dayOfMonth": {
                    "type": "number",
                    "description": "每月的第几天"
                  },
                  "index": {
                    "type": "string",
                    "description": "第几周：first, second, third, fourth, last"
                  },
                  "firstDayOfWeek": {
                    "type": "string",
                    "description": "一周起始日，默认sunday"
                  }
                }
              },
              "range": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "循环范围类型：noEnd, endDate, numbered"
                  },
                  "endDate": {
                    "type": "string",
                    "description": "循环结束日期"
                  },
                  "numberOfOccurrences": {
                    "type": "number",
                    "description": "循环次数"
                  }
                }
              }
            }
          },
          "onlineMeetingInfo": {
            "type": "object",
            "description": "创建日程同时创建线上会议。对象包含type字段，目前只支持\"dingtalk\"（钉钉视频会议）。示例：{\"type\":\"dingtalk\"}",
            "properties": {
              "type": {
                "type": "string",
                "description": "会议类型，如dingtalk"
              }
            }
          },
          "extra": {
            "type": "object",
            "description": "扩展配置，如noPushNotification、noChatNotification等。示例：{\"noPushNotification\":\"true\",\"noChatNotification\":\"false\"}"
