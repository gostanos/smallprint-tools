                    ]
                  }
                },
                "required": [
                  "irVersion",
                  "source"
                ],
                "additionalProperties": {}
              }
            ]
          },
          "output": {
            "type": "string",
            "minLength": 1
          },
          "overwrite": {
            "type": "boolean"
