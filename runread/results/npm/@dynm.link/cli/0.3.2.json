    {
      "name": "create_link",
      "description": "Create a link of any type; `content` must be that type's (redirect: { web, rules?, preview? }; text: { body, markdown?, theme?, font? }; bio: { name, links, headline?, avatar?, theme?, font? }; file: { r2Key, filename }). A bio's `avatar` is the http(s) URL of an image, or `{ r2Key }` for an uploaded one; `theme` is the paper a bio or text page is printed on (kraft, sage, blush, newsprint, slate or night; omitted, the house paper), and `font` the type it is set in (grotesk, serif or mono; omitted, grotesk). A redirect's `preview` defaults to `follow` (a share unfurls the destination's own card); set it to `custom` to use `title` / `description` instead; that is the only way a redirect may have them.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "description": "The domain to create it on; omitted, your only one (required once you have a custom domain)."
          },
          "slug": {
            "type": "string",
            "allOf": [
              {
                "maxLength": 64
              }
            ],
            "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*(?:\\/[a-z0-9]+(?:-[a-z0-9]+)*)*|(?:[a-z0-9]+(?:-[a-z0-9]+)*\\/)*\\*)?$",
            "description": "Lowercase letters, digits and single hyphens; `/` separates path segments and a trailing `*` matches the rest. Empty publishes at the folder's root."
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
