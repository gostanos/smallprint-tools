                "properties": {},
                "additionalProperties": {}
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {}
              }
            ],
            "description": "What Jev judges: text, a JSON object or a JSON array. Send only what the questions need; extra detail lowers accuracy. Max ~32k tokens."
          },
          "files": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
