    {
      "name": "fixed_user_create_query_task",
      "description": "为用户集创建一次定向分析查询。这是写操作：会提交大数据计算任务，异步执行，完成后飞书通知 operator。只在用户明确要求创建查询时调用；调用前和用户确认用户集、领域 domains、统计区间 startDate~endDate（最晚到昨天）、版本（不传用用户集的圈选版本）、是否需要下探（drillDownDomains 不传=所选领域都算下探，传 []=只算总览、更快）。operator 是用户自己的小米账号（邮箱前缀），必须是该用户集的创建人，不知道时先问用户。返回 duplicate=true 表示已有相同条件的任务、本次没有创建：先问用户是直接看 existingTask，还是 allowDuplicate=true 重新创建。创建成功后告诉用户 taskId，并说明需要等计算完成，可稍后用 fixed_user_query_task_list 查看状态。完整口径读 exp-dashboard://docs/fixed-user-tracking-api.md。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operator": {
            "description": "操作人小米账号（邮箱前缀），须为用户集创建人；不传时使用 MCP 配置的 EXP_DASHBOARD_OPERATOR，两者都没有时会报错，需先问用户。",
            "type": "string"
          },
          "groupId": {
            "type": "string",
            "minLength": 1,
            "description": "必填。用户集 ID，取自 fixed_user_group_list，状态须为 ACTIVE。"
          },
          "domains": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "功耗",
                "性能",
                "稳定性",
                "相机",
                "热",
                "充电",
                "蜂窝通信"
              ]
            },
            "description": "必填。查询领域，可多选；用户没说时先问，不要默认。所有领域都只有国内数据，只支持国内用户集；性能只支持 OS / V816 开头的版本。"
          },
          "startDate": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "必填。统计起始 yyyyMMdd。"
          },
          "endDate": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "必填。统计末日 yyyyMMdd，最晚到昨天。"
          },
          "versions": {
            "description": "目标版本，最多 100 个；不传取用户集的圈选版本。",
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "drillDownDomains": {
            "description": "需要计算下探的领域。不传 = 所选领域都算下探（与页面默认一致）；传 [] = 只算总览。蜂窝通信只有总览，列入也只算总览。充电的下探结果没有 MCP 接口，需告诉用户去看板查看。",
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "功耗",
                "性能",
                "稳定性",
                "相机",
                "热",
                "充电",
                "蜂窝通信"
              ]
            }
          },
          "allowDuplicate": {
            "description": "已有相同条件的任务时是否仍然创建，默认 false；只在用户确认要重新创建时传 true。",
            "type": "boolean"
          },
          "requestId": {
            "description": "请求标识，会透传到接口响应。",
            "type": "string"
          }
        },
        "required": [
          "groupId",
          "domains",
          "startDate",
          "endDate"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "fixed_user_task_overview",
      "description": "查看某条定向分析查询记录的总览指标结果（指标值、基线、对比基线状态、命中设备覆盖）。领域：任务只有一个领域时可省略 domain；任务有多个领域时先问用户是只看某个领域（传 domain）还是需要全部领域（传 allDomains=true），不要替用户选。统计区间不传时取任务末日往前 7 天（与结果页一致），实际生效值见 query 和 domains[].startDate/endDate，解读时要说明统计区间与版本。percentTag=是 时 periodValue / baseline 已是百分数，不要再乘 100。domains[].notes 提示还有下一页时用 page 继续取，不要截断或抽样。allDomains 模式下 domains[].error 表示该领域取数失败，如实告诉用户。完整口径读 exp-dashboard://docs/fixed-user-tracking-api.md。",
