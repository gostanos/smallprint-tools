            "type": "string",
            "enum": [
              "periodValue",
              "baseline"
            ]
          },
          "sortOrder": {
            "description": "排序方向。",
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "page": {
            "description": "页码，对每个领域独立生效。",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "pageSize": {
