          },
          "requestId": {
            "description": "请求标识，会透传到接口响应。",
            "type": "string"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "drill_down",
      "description": "查询多机型多版本在【单个指标】上的下探数据：分布类返回完整分桶及均值/中位数/P95，功耗异常类返回按指标值降序的前 N 个来源（应用包名或子系统）。下探是指标级的：用户没有明确指定具体指标时，先询问用户（可用 drill_down_metric_tree 列出候选），不要自己挑指标。日期规则同 metric_data：只说单个日期时只填 endDate；都不传时取数据最新日期往前 7 天，实际窗口见 result.startDate/endDate。buckets[].percentage 已是 0~100 的百分数；sources[].value 已是 result.unit 单位，均不要再换算。结果里 hasData=false 表示该版本该时间窗没有下探数据，不要当成 0。dashboardOnlyAnalyses 列出的分析模块本工具不覆盖，提示用户去看板查看。完整口径读 exp-dashboard://docs/overview-api.md。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "selections": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "project": {
                  "type": "string",
