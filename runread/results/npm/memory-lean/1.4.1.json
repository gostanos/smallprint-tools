                "relationType"
              ]
            }
          }
        },
        "required": [
          "relations"
        ]
      }
    },
    {
      "name": "add_observations",
      "description": "Add observations to existing entities. One fact each, at most 300 characters. Replace stale facts with delete_observations rather than appending corrections. Entities over 15 observations have their oldest dated ones moved to archive/.",
      "inputSchema": {
        "type": "object",
        "properties": {
