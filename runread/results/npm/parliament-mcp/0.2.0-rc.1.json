    {
      "name": "wait_for_mic",
      "description": "Long-poll for your turn. Returns carry ONLY the new events (delta contract); the full ledger/turn_board arrive on mic grant, adjournment, or when you pass resync:true once (e.g. after context loss). Keep looping while the debate is live; during assembly, returns are deliberately short. Omit last_event_seq to resume from the server-tracked cursor; 0 replays everything.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "debate_id": {
            "type": "string",
            "description": "Debate id, e.g. \"my-plan-20260731-1042\""
