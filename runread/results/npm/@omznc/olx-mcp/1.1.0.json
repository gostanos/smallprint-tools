            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "brand_id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "model_id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "city_id": {
            "description": "City id from olx_cities",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "canton_id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "price_from": {
            "description": "Minimum price in KM",
            "type": "number"
          },
          "price_to": {
            "description": "Maximum price in KM",
            "type": "number"
          },
          "state": {
            "description": "Item condition",
            "type": "string",
            "enum": [
              "new",
              "used"
            ]
          },
          "listing_type": {
            "type": "string",
            "enum": [
              "sell",
              "buy",
              "rent"
            ]
          },
          "sort_by": {
            "description": "Field to sort on. Default is OLX's own relevance ordering.",
            "type": "string",
            "enum": [
              "price",
              "created_at",
              "renewed_at"
