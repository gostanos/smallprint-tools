      "name": "search_products",
      "description": "Search products across all connected Australian retailers. Returns matched products with current pricing, availability, and delivery estimates. Use this as the entry point for any price-discovery query.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Natural language query, e.g. \"15mm bent socket wrench in Melbourne with 2-day delivery\""
          },
          "max_price_aud": {
            "description": "Maximum total price including shipping, in AUD",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "min_price_aud": {
            "description": "Minimum total price filter (useful to exclude scam-priced outliers)",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "location_postcode": {
            "description": "AU postcode for delivery-time estimation",
            "type": "string",
            "pattern": "^\\d{4}$"
          },
          "delivery_by": {
            "description": "ISO date by which the product must be delivered",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "in_stock_only": {
            "default": true,
            "description": "Exclude out-of-stock offers (default true)",
            "type": "boolean"
          },
          "category_hint": {
            "description": "Category narrowing hint, e.g. \"tools/hand-tools\"",
            "type": "string"
          },
          "max_results": {
            "default": 10,
            "description": "Max results to return (default 10)",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "query"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
